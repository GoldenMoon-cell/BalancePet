<Window x:Class="BalancePet.UsageAnalytics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BalancePet 用量中心" Icon="assets/balance-pet.ico"
        Width="1120" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="{DynamicResource WindowCornerRadius}" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Height="48" VerticalAlignment="Top"
            Background="{StaticResource SidebarBrush}" BorderBrush="#1B304A" BorderThickness="0,0,0,1"
            Panel.ZIndex="10" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
      <Grid Margin="18,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="{StaticResource AccentBrush}" CornerRadius="9" Margin="0,0,9,0">
            <Image Source="assets/balance-pet.ico" Width="22" Height="22" Stretch="Uniform"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BalancePet" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="用量中心" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Click="OnMinimizeClick"
                  ToolTip="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="{StaticResource MinimizeIconGeometry}" Stroke="{StaticResource MutedBrush}"
                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="OnCloseClick"
                  ToolTip="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource MutedBrush}"
                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Column="0" Margin="0,48,0,0" Background="{StaticResource SidebarBrush}"
            BorderBrush="#172B45" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,22,18,18">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="工作台" Foreground="#61738E" FontSize="11" Margin="14,0,0,9"/>
          <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Background="#123148"
                  Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Click="OnDashboardNavClick">
            <Button.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DashboardIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.14" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="DashboardIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.14" Duration="0:0:0.14"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DashboardIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="DashboardIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Button.Triggers>
            <StackPanel Orientation="Horizontal">
              <Path x:Name="DashboardIcon" Data="{StaticResource DashboardIconGeometry}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="14" Height="14" Stretch="Uniform" Margin="1,0,13,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.RenderTransform>
              </Path>
              <TextBlock Text="仪表盘" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="OnHistoryNavClick">
            <Button.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HistoryIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.14" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="HistoryIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.14" Duration="0:0:0.14"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HistoryIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="HistoryIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Button.Triggers>
            <StackPanel Orientation="Horizontal">
              <Path x:Name="HistoryIcon" Data="{StaticResource HistoryIconGeometry}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="14" Height="14" Stretch="Uniform" Margin="1,0,13,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.RenderTransform>
              </Path>
              <TextBlock Text="使用记录" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="DataDirectoryNav" Style="{StaticResource NavButton}" Click="OnOpenDataClick">
            <Button.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FolderIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.14" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="FolderIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.14" Duration="0:0:0.14"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FolderIcon" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="FolderIcon" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Button.Triggers>
            <StackPanel Orientation="Horizontal">
              <Path x:Name="FolderIcon" Data="{StaticResource FolderIconGeometry}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="14" Height="14" Stretch="Uniform" Margin="1,0,13,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.RenderTransform>
              </Path>
              <TextBlock Text="数据目录" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
          <Border Height="1" Background="#1B304A" Margin="5,0,5,16"/>
          <TextBlock Text="本地只读统计" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="14,0,0,6"/>
          <TextBlock Text="不读取令牌、提示词或回复" Foreground="#6D829F" FontSize="11"
                     TextWrapping="Wrap" Margin="14,0,8,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" Margin="0,48,0,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnContentScrollChanged">
      <StackPanel Margin="28,26,30,30">
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="仪表盘" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="本机 AI 请求与 Token 使用概览" Foreground="{StaticResource MutedBrush}"
                       FontSize="13" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="账户" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AccountSelector" Width="164" Height="30" Style="{StaticResource TrendRangeComboBox}"
                      SelectionChanged="OnAccountSelectionChanged" Margin="0,0,12,0"/>
            <Button x:Name="RefreshButton" Click="OnRefreshClick" Padding="14,8" Height="36"
                    Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    ToolTip="重新读取数据目录，并请求主程序刷新余额">
              <Button.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="RefreshIcon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1.12" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="RefreshIcon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1.12" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="RefreshIcon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1" Duration="0:0:0.16"/>
                      <DoubleAnimation Storyboard.TargetName="RefreshIcon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Button.Triggers>
              <StackPanel Orientation="Horizontal">
                <!-- Open arc: stroked, never filled. Stretch scales the pen by
                     15/10, so a thickness of 1 renders at about 1.5. -->
                <Path x:Name="RefreshIcon" Data="{StaticResource RefreshIconGeometry}"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="1" ScaleY="1"/>
                      <RotateTransform Angle="0"/>
                    </TransformGroup>
                  </Path.RenderTransform>
                </Path>
                <TextBlock Text="刷新" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,6,0" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="近 24 小时 Token" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="TwentyFourHourTokens" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
              <TextBlock Text="输入 + 输出" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Margin="6" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="累计 Token" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="AllTimeTokens" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource BlueBrush}" Margin="0,8,0,0"/>
              <TextBlock x:Name="AllTimeTokenBreakdown" Text="输入 — / 输出 —" Foreground="{StaticResource SubtleBrush}"
                         FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Margin="6" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="请求次数" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="Requests" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource PurpleBrush}" Margin="0,8,0,0"/>
              <TextBlock x:Name="SuccessRate" Text="成功率 —" Foreground="{StaticResource SubtleBrush}"
                         FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Margin="6,0,0,0" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="缓存命中率" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="CacheHit" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource OrangeBrush}" Margin="0,8,0,0"/>
              <TextBlock Text="Cache Read / Input" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,6,0" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="余额变化估算" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="TodayUsage" Text="暂无数据" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock x:Name="TodayUsageHint" Text="本地余额下降估算 · 今日" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Margin="6" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="输出速度" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="Throughput" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock Text="Output / duration" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Margin="6" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="平均任务耗时" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="AverageDuration" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock Text="事件记录耗时" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Margin="6,0,0,0" Padding="15,14" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="提供方 / 模型" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="ProviderModelCount" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock Text="已记录的维度" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="17,15" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="本地余额快照" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="TotalBalance" Text="暂无数据" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock x:Name="TotalBalanceHint" Text="主程序尚无余额快照" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="18,0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,1,0" Padding="18,0">
              <StackPanel>
                <TextBlock Text="累计余额变化" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock x:Name="TotalUsage" Text="暂无数据" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock x:Name="TotalUsageHint" Text="等待主程序累计记录" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Margin="18,0,0,0">
              <TextBlock Text="站点今日用量" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="ServerUsageSummary" Text="暂无数据" FontSize="25" FontWeight="SemiBold"
                         Foreground="{StaticResource PurpleBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ServerUsageSummaryHint" Text="当前站点尚无今日用量" Foreground="{StaticResource SubtleBrush}"
                         FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="分析范围" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="TrendRangeSelector" Grid.Column="1" Width="170" Height="30"
                      SelectedIndex="1" Style="{StaticResource TrendRangeComboBox}" SelectionChanged="OnTrendRangeChanged">
              <ComboBoxItem Tag="Last24Hours" Content="近 24 小时 · 按小时"/>
              <ComboBoxItem Tag="Last7Days" Content="近 7 天 · 按天"/>
              <ComboBoxItem Tag="Last30Days" Content="近 30 天 · 按天"/>
              <ComboBoxItem Tag="Last90Days" Content="近 90 天 · 按周"/>
              <ComboBoxItem Tag="AllTime" Content="全部 · 按月"/>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="Token 趋势会随范围自动重绘" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border x:Name="ProviderPanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="17,15" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,11">
              <TextBlock Text="按提供方拆分" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="ProviderSummary" Grid.Column="1" HorizontalAlignment="Right"
                         Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </Grid>
            <ItemsControl x:Name="ProviderItems">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="218" Margin="0,0,10,0" Padding="13" Background="{StaticResource PanelAltBrush}"
                          BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RequestText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding TokenText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ShareText}" Foreground="{Binding Brush}"
                                 FontWeight="SemiBold" VerticalAlignment="Top"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
          <Border x:Name="ModelPanel" Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,15">
            <StackPanel>
              <TextBlock Text="模型分布" FontSize="17" FontWeight="SemiBold"/>
              <ItemsControl x:Name="ModelItems" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding TokenText}" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </Grid>
                      <ProgressBar Grid.Row="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5"
                                   Margin="0,5,0,0" Foreground="{Binding Brush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="ModelEmpty" Text="暂无模型 Token 数据" Foreground="{StaticResource MutedBrush}"
                         FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,15">
            <StackPanel>
              <TextBlock Text="Token 使用趋势" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <WrapPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource BlueBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Input" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Output" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource OrangeBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Cache Creation" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Ellipse Width="8" Height="8" Fill="#15C7D7" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Cache Read" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Cache Hit Rate" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
              </WrapPanel>
              <Grid Margin="0,8,0,0">
                <Canvas x:Name="TrendChart" Height="218" Background="Transparent" SizeChanged="OnChartSizeChanged"
                        MouseMove="OnTrendChartMouseMove" MouseLeave="OnTrendChartMouseLeave"/>
                <TextBlock x:Name="TrendEmpty" Text="暂无 Token 数据；有 Token 事件后将在这里绘制趋势"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <DockPanel Margin="0,13,0,0">
          <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     FontSize="11" VerticalAlignment="Center"/>
          <Button x:Name="OpenDataButton" DockPanel.Dock="Right" Content="打开数据目录"
                  Click="OnOpenDataClick" Padding="12,7"/>
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
    <!-- A Grid rather than a ScrollViewer: the list must be given a bounded
         height, otherwise it never virtualizes and every row is realized at
         once, which makes switching the client filter take seconds. -->
    <Grid x:Name="HistoryScrollViewer" Grid.Column="1" Margin="0,48,0,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="28,26,30,20">
        <StackPanel>
          <TextBlock Text="使用记录" FontSize="28" FontWeight="Bold"/>
          <TextBlock Text="逐条查看请求的模型与 Token；站点汇总额度显示在仪表盘" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock x:Name="RecentSummary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </Grid>
      <WrapPanel x:Name="ProviderFilterPanel" Grid.Row="1" Orientation="Horizontal" Margin="28,0,30,12"/>
      <Border x:Name="RecentPanel" Grid.Row="2" Margin="28,0,30,30"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="12">
        <ListView x:Name="EventsList" SelectionChanged="OnEventSelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Padding="0" Margin="0" Background="Transparent"
                        BorderBrush="Transparent" BorderThickness="0" CornerRadius="9"
                        Cursor="Hand" MouseLeftButtonUp="OnEventCardClick">
                  <Grid MinWidth="700">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding OccurredAtText}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                      <TextBlock Text="{Binding ProviderLine}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Model}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ReasoningText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="0,0,14,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding InputText}" Foreground="{StaticResource BlueBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding CacheReadText}" Foreground="#15C7D7" FontSize="11" Margin="0,5,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding OutputText}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding CacheWriteText}" Foreground="{StaticResource OrangeBrush}" FontSize="11" Margin="0,5,0,0"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CostCaption}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right"/>
                      <TextBlock Text="{Binding CostText}" Foreground="{StaticResource PurpleBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
      </Border>
    </Grid>
    <Grid x:Name="HistoryDetailView" Grid.Column="1" Margin="0,48,0,0" Visibility="Collapsed" Opacity="0"
          Background="{StaticResource PageBrush}">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="HistoryDetailScale" ScaleX="0.97" ScaleY="0.97"/>
      </Grid.RenderTransform>
      <ScrollViewer x:Name="HistoryDetailScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,30,30">
          <Button x:Name="DetailBackButton" Click="OnDetailBackClick" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="0,4" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 10,2 L 4,8 L 10,14" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" Stretch="None" Width="14" Height="16" Margin="0,0,7,0"/>
              <TextBlock Text="返回使用记录" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Grid Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="使用记录详情" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="单次任务的 Token 构成、额度变化与中转请求" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding OccurredAtText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </Grid>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,15" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding ProviderLine}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Model}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding ReasoningText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="任务状态" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CostCaption}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Right"/>
                <TextBlock Text="{Binding CostText}" Foreground="{StaticResource PurpleBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextAlignment="Right"/>
                <TextBlock Text="{Binding CostNote}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextAlignment="Right" MaxWidth="260" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Token 构成" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="输入、缓存与输出的相对比例" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                <Canvas x:Name="TokenCompositionChart" Height="74" SizeChanged="OnDetailChartSizeChanged"/>
                <TextBlock x:Name="TokenChartEmpty" Text="暂无 Token 数据" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Border x:Name="CostTimelinePanel" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="额度时间线" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="每次中转请求的费用变化" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                <Canvas x:Name="CostTimelineChart" Height="74" SizeChanged="OnDetailChartSizeChanged"/>
                <TextBlock x:Name="CostChartEmpty" Text="暂无逐条额度明细" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="TokenTrendPanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Token 趋势" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="按时间查看本次任务每次请求的输入、缓存读取与输出变化" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" Margin="0,0,5,0"/>
                    <TextBlock Text="输入" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Ellipse Width="7" Height="7" Fill="#15C7D7" Margin="0,0,5,0"/>
                    <TextBlock Text="缓存读取" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                    <TextBlock Text="输出" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Canvas x:Name="TokenTrendChart" Height="168" SizeChanged="OnDetailChartSizeChanged" Margin="0,10,0,0"/>
              <TextBlock x:Name="TokenTrendEmpty" Text="暂无逐条 Token 数据" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Border x:Name="RelayDetailPanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
            <StackPanel>
              <TextBlock Text="中转请求明细" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="按时间查看本次任务的每次请求、Token 与费用" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,9"/>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="时间" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="1" Text="模型" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="2" Text="输入" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="3" Text="输出" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="4" Text="额度" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding ModelEffortText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding InputText}" Foreground="{StaticResource BlueBrush}" FontSize="10" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding OutputText}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding CostText}" Foreground="{StaticResource PurpleBrush}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
