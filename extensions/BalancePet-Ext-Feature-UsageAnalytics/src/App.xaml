<Application x:Class="BalancePet.UsageAnalytics.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#07111F"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D1A2D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#101F33"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#14263D"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#19324D"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#223953"/>
    <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#2D4B6B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#93A3BA"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#6F829E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2DE1C2"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#6EA8FF"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#B586FF"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#F4B942"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF7086"/>
    <Geometry x:Key="BrandMarkGeometry">M 3,5 L 8,5 L 8,7 L 6.2,7 L 11.6,12.4 L 10.1,13.9 L 4.7,8.5 L 4.7,12 L 3,12 Z</Geometry>
    <Geometry x:Key="DashboardIconGeometry">M 2,2 H 6 V 6 H 2 Z M 8,2 H 12 V 6 H 8 Z M 2,8 H 6 V 12 H 2 Z M 8,8 H 12 V 12 H 8 Z</Geometry>
    <Geometry x:Key="HistoryIconGeometry">M 2,2 H 12 V 4 H 2 Z M 2,6 H 12 V 8 H 2 Z M 2,10 H 9 V 12 H 2 Z</Geometry>
    <Geometry x:Key="ProviderIconGeometry">M 7,1.5 L 12.5,7 L 7,12.5 L 1.5,7 Z M 5,7 H 9</Geometry>
    <Geometry x:Key="FolderIconGeometry">M 1.5,3 H 5 L 6.5,4.5 H 12.5 V 12.5 H 1.5 Z</Geometry>
    <Geometry x:Key="MinimizeIconGeometry">M 2,8 H 12</Geometry>
    <Geometry x:Key="CloseIconGeometry">M 3,3 L 11,11 M 11,3 L 3,11</Geometry>
    <Geometry x:Key="RefreshIconGeometry">M 12,6 A 5,5 0 1 0 10.3,10.1 M 12,2.5 V 6 H 8.5</Geometry>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PanelHoverBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#244467"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#16BFA7"/>
      <Setter Property="Foreground" Value="#06131D"/>
      <Setter Property="BorderBrush" Value="#16BFA7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Foreground" Value="#B9C7DB"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#132A43"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,3,0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{StaticResource PanelHoverBrush}"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#1A3A4D"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AnalyticsScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#29445F"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Margin="2" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#3B607F"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#0A1727"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource AnalyticsScrollThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="10"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Background" Value="Transparent"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#20344C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="5"/>
    </Style>
  </Application.Resources>
</Application>
