<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalancePet.NotificationCenter</AssemblyName>
    <RootNamespace>BalancePet.NotificationCenter</RootNamespace>
    <Version>0.5.15</Version>
    <AssemblyVersion>0.5.15.0</AssemblyVersion>
    <FileVersion>0.5.15.0</FileVersion>
    <InformationalVersion>0.5.15</InformationalVersion>
    <ApplicationIcon>..\..\BalancePet-Ext-Feature-UsageAnalytics\src\assets\balance-pet.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\BalancePet-Ext-Feature-UsageAnalytics\src\assets\balance-pet.ico" Link="assets\balance-pet.ico" />
  </ItemGroup>
</Project>
