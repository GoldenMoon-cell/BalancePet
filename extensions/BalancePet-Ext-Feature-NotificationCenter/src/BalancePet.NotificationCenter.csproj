<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalancePet.NotificationCenter</AssemblyName>
    <RootNamespace>BalancePet.NotificationCenter</RootNamespace>
    <Version>0.6.1</Version>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <FileVersion>0.6.1.0</FileVersion>
    <InformationalVersion>0.6.1</InformationalVersion>
    <!-- The extension's own face: a tile per extension, so its window carries its character in
         the taskbar and its title bar rather than the host's generic icon. Declared as resources
         like the icon above, and for the same reason — an asset that is not declared is an asset
         that is not in the package, and both of these fail silently when missing. -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\balance-pet.ico" />
    <Resource Include="assets\app.ico" />
    <Content Include="assets\avatar.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
