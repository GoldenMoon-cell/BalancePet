<Window x:Class="BalancePet.NotificationCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="消息中心" Icon="assets/balance-pet.ico" Width="860" Height="620" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="{DynamicResource WindowCornerRadius}" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="IconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" /><Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Root" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- The one action a row can have. Declared before the row template that uses it. -->
    <Style x:Key="RowActionStyle" TargetType="Button">
      <Setter Property="Height" Value="22" /><Setter Property="Padding" Value="13,0" />
      <Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.64" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- A section row: the shape the settings window uses for its sidebar, so the two
         windows are navigated the same way. -->
    <Style x:Key="SectionItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,1,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Root" CornerRadius="9" Background="Transparent" Height="38">
          <Grid>
            <Border x:Name="Mark" Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="16,0,10,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- A message row. One shape for every kind of message: an accent, a title, an optional
         tag, a date, a line of body and at most one action. The changelog, a version notice
         and a balance change all fit it, which is the point of drawing it this way. -->
    <DataTemplate x:Key="MessageRowTemplate">
      <Border x:Name="RowRoot" Loaded="RowLoaded" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource CardCornerRadius}" Opacity="0" Margin="0,0,0,8"
              RenderTransformOrigin="0,0.5">
        <Grid Height="78">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="3" Margin="12,16,0,16" CornerRadius="1.5" Background="{Binding CategoryBrush}" />
          <StackPanel Grid.Column="1" Margin="14,13,12,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Border Background="{Binding CategorySoftBrush}" CornerRadius="9" Padding="7,1" Margin="10,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CategoryText}" Foreground="{Binding CategoryBrush}" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding OccurredAtText}" Foreground="{DynamicResource MutedBrush}"
                     FontSize="11.5" VerticalAlignment="Top" Margin="0,16,0,0" />
          <Button Grid.Column="3" Content="打开" Style="{StaticResource RowActionStyle}" Margin="12,0,16,10"
                  VerticalAlignment="Bottom" Click="RowActionClick" Tag="{Binding Url}"
                  Visibility="{Binding ActionVisibility}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The takeover switch: a pill that slides, because it changes how the pet behaves
         rather than what this window shows. -->
    <Style x:Key="SwitchStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource BorderBrush}">
            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
              <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift" X="0" /></Ellipse.RenderTransform>
            </Ellipse>
          </Border>
          <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
            <Trigger.EnterActions>
              <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18">
                  <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard></BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
              </Storyboard></BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- Title bar, with the pet itself in it: the one thing that makes this window
         unmistakably the pet's rather than a generic list. -->
    <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
            <Image x:Name="PetAvatar" Stretch="UniformToFill" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="消息中心" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="TitleSubtitle" Text="更新记录与桌面提示" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButtonStyle}" Click="MinimizeClick" ToolTip="最小化">
            <Path Data="M3,8 L13,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="16" Height="16" Stretch="Uniform" />
          </Button>
          <Button Style="{StaticResource IconButtonStyle}" Click="MaximizeClick" ToolTip="最大化">
            <Path Data="M3,3 L13,3 L13,13 L3,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" />
          </Button>
          <Button Style="{StaticResource CloseButtonStyle}" Click="CloseClick" ToolTip="关闭">
            <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <!-- Sections, and the settings that belong to the whole extension. -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ListBox x:Name="SectionList" Grid.Row="0" Margin="10,14,10,0" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource SectionItemStyle}" SelectionChanged="SectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid>
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding BadgeVisibility}">
                  <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Margin="26,0,16,22">
            <TextBlock Text="设置" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
            <CheckBox x:Name="TakeoverSwitch" Style="{StaticResource SwitchStyle}" Content="接管气泡提醒"
                      FontSize="12.5" Click="TakeoverChanged" />
            <TextBlock Text="开启后由本窗口显示桌宠原本要弹出的气泡消息；关掉则两者都会有。"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="24,0,20,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,22,0,14">
          <TextBlock x:Name="SectionTitle" Text="更新记录" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="SectionSubtitle" Text="共 0 条" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Bottom" Margin="10,0,0,3" />
        </StackPanel>

        <Grid Grid.Row="1">
          <ListBox x:Name="EventsList" Background="Transparent" BorderThickness="0" Padding="0"
                   ItemTemplate="{StaticResource MessageRowTemplate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="Collapsed">
            <Border Width="60" Height="60" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
              <Path Data="M6,5 L18,5 C19.1,5 20,5.9 20,7 L20,15 C20,16.1 19.1,17 18,17 L12,17 L8,21 L8,17 L6,17 C4.9,17 4,16.1 4,15 L4,7 C4,5.9 4.9,5 6,5 Z M8,9 L16,9 M8,12 L14,12"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="Uniform" Width="28" Height="28" />
            </Border>
            <TextBlock x:Name="EmptyText" Text="这里还没有内容。桌宠获取到新消息后会出现在这里。" Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,10,2,14">
          <TextBlock x:Name="StatusText" Text="本地保存 · 关闭窗口后继续在后台" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="消息中心 · v0.5.16" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
