<Application x:Class="BalancePet.NotificationCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">9</CornerRadius>
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#EDF1F7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FBFCFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E8EDF6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7DFEE" />
    <SolidColorBrush x:Key="TextBrush" Color="#26324D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#71809D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#078C82" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF3F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C43B52" />
    <!-- 主程序会在状态快照里发布它正在用的字体，插件读到后替换这一项；在读到之前用同一个
         回退栈，所以窗口在第一时间也不会跳字体。 -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
  </Application.Resources>
</Application>
