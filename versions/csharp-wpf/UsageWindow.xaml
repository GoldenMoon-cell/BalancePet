<Window x:Class="BalancePet.Wpf.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用量统计" Width="430" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="#F7F9FD">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="最近用量" FontSize="24" FontWeight="Bold" Foreground="#263D78"/>
      <TextBlock Text="本机保存的余额变化记录" Margin="0,4,0,0" Foreground="#7183AD"/>
    </StackPanel>
    <ListView x:Name="HistoryList" Grid.Row="1" Background="White" BorderBrush="#D6DEEF" BorderThickness="1" Padding="6">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Header="日期" DisplayMemberBinding="{Binding Date}" Width="120"/>
          <GridViewColumn Header="货币" DisplayMemberBinding="{Binding Currency}" Width="76"/>
          <GridViewColumn Header="消耗" DisplayMemberBinding="{Binding UsageText}" Width="150"/>
        </GridView>
      </ListView.View>
    </ListView>
    <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,12,0,0" Foreground="#526A9E" HorizontalAlignment="Right"/>
  </Grid>
</Window>
