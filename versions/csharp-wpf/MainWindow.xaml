<Window x:Class="BalancePet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BalancePet" Width="430" Height="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Topmost="True" ShowInTaskbar="False" ClipToBounds="False"
        >
  <Canvas ClipToBounds="False">
    <Grid x:Name="BubbleGroup" Canvas.Left="5" Canvas.Top="8" Width="315" Panel.ZIndex="1" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.72,1" MouseLeftButtonDown="OnBubbleClick">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BubbleScale" ScaleX="0.76" ScaleY="0.76"/>
          <TranslateTransform x:Name="BubbleTranslate" Y="16"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <!-- Height is content-driven rather than pinned at 210. At the minimum it is a
           capsule (CornerRadius 105 is exactly half of 210), and as the text needs
           more room it grows into a rounded rectangle instead of clipping. WPF caps
           the radius at half the shorter side, so no radius change is needed for the
           shape to stay correct; MaxHeight keeps an unexpectedly long message from
           covering the screen, and text is truncated before it can reach that. -->
      <Border Width="300" MinHeight="210" MaxHeight="400" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" BorderBrush="#263D78" BorderThickness="5" CornerRadius="105" Padding="24">
        <StackPanel x:Name="BubbleContent" VerticalAlignment="Center" Opacity="1" RenderTransformOrigin="0.5,0.5">
          <TextBlock x:Name="BubbleLabel" Text="账户余额" Foreground="#667DB1" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="BubbleAmount" Text="--" Foreground="#263D78" FontSize="39" FontWeight="Bold" HorizontalAlignment="Center" Width="252" Margin="0,4" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"/>
          <TextBlock x:Name="BubbleHint" Text="点击角色刷新" Foreground="#8092BC" FontSize="13" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="252"/>
          <!-- Only visible while an update downloads. Rounded and in the bubble's own
               blue family so it reads as part of the speech bubble rather than a
               stock control dropped on top of it. -->
          <ProgressBar x:Name="BubbleProgress" Height="9" Minimum="0" Maximum="1" Value="0"
                       Width="252" Margin="0,12,0,0" Visibility="Collapsed"
                       Background="Transparent" BorderThickness="0" Foreground="#4B6FD6">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Border Background="#DCE4F2" CornerRadius="5" ClipToBounds="True">
                  <Grid>
                    <Rectangle x:Name="PART_Track"/>
                    <Rectangle x:Name="PART_Indicator" Fill="#4B6FD6" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                  </Grid>
                </Border>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>
        </StackPanel>
      </Border>
      <Ellipse Width="37" Height="26" Fill="White" Stroke="#263D78" StrokeThickness="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,21,34"/>
      <Ellipse Width="22" Height="16" Fill="White" Stroke="#263D78" StrokeThickness="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
    </Grid>

    <!-- Keep the visual in a larger, hit-test-free buffer so transforms can extend
         past the 238px interaction area without being clipped at its edge. -->
    <Grid x:Name="PetRenderBuffer" Canvas.Right="0" Canvas.Bottom="0" Width="300" Height="300" Panel.ZIndex="2" IsHitTestVisible="False" ClipToBounds="False">
      <Grid x:Name="PetVisualHost" Width="238" Height="238" HorizontalAlignment="Right" VerticalAlignment="Bottom" ClipToBounds="False">
        <Image x:Name="PetImage" Stretch="Uniform" Margin="0,0,0,-6" RenderTransformOrigin="0.5,0.86"
               RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="False"
               IsHitTestVisible="False" ClipToBounds="False"/>
        <Ellipse x:Name="StatusDot" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,27" Fill="#91A2C8" Stroke="White" StrokeThickness="3"/>
      </Grid>
    </Grid>

    <Grid x:Name="PetSurface" Canvas.Right="0" Canvas.Bottom="0" Width="238" Height="238" Panel.ZIndex="3" Background="Transparent" ClipToBounds="False" MouseLeftButtonDown="OnMouseLeftButtonDown" MouseLeftButtonUp="OnMouseLeftButtonUp" LostMouseCapture="OnPetLostMouseCapture" MouseMove="OnPetMouseMove" ContextMenuOpening="OnPetContextMenuOpening">
      <Grid.ContextMenu>
        <ContextMenu x:Name="PetContextMenu" Placement="MousePoint">
          <MenuItem x:Name="ContextRefreshMenuItem" Header="立即刷新" Click="OnContextRefreshClick"/>
          <MenuItem x:Name="BubbleMenuItem" Header="显示气泡" Click="OnContextBubbleClick"/>
          <MenuItem x:Name="InteractionMenuItem" Header="切换为锁定互动" Click="OnContextInteractionClick"/>
          <!-- Filled from PetStyleCatalog.GetAvailableStyles() so this menu, the tray
               menu and the settings selector cannot disagree. A written list would
               offer appearances this machine has never had and would miss any package
               the program has never heard of. -->
          <MenuItem x:Name="ContextStyleMenuItem" Header="切换形象"/>
          <MenuItem x:Name="MonitorMenuItem" Header="当前账户"/>
          <Separator/>
           <MenuItem x:Name="ContextSettingsMenuItem" Header="设置面板" Click="OnContextSettingsClick"/>
          <MenuItem x:Name="ContextUpdateMenuItem" Header="检查更新" Click="OnContextUpdateClick"/>
          <MenuItem x:Name="ContextUsageMenuItem" Header="用量统计" Click="OnContextUsageClick"/>
          <MenuItem x:Name="ContextNotificationMenuItem" Header="消息中心" Click="OnContextNotificationClick"/>
          <MenuItem x:Name="ContextHideMenuItem" Header="隐藏桌宠" Click="OnContextHideClick"/>
          <Separator/>
          <MenuItem x:Name="ContextExitMenuItem" Header="退出" Click="OnContextExitClick"/>
        </ContextMenu>
      </Grid.ContextMenu>
    </Grid>
  </Canvas>
</Window>
