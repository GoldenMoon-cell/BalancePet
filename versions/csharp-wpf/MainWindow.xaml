<Window x:Class="BalancePet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BalancePet" Width="430" Height="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Topmost="True" ShowInTaskbar="False"
        >
  <Canvas>
    <Grid x:Name="BubbleGroup" Canvas.Left="5" Canvas.Top="8" Width="315" Height="220" Panel.ZIndex="1" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.72,1" MouseLeftButtonDown="OnBubbleClick">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BubbleScale" ScaleX="0.76" ScaleY="0.76"/>
          <TranslateTransform x:Name="BubbleTranslate" Y="16"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Width="300" Height="210" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" BorderBrush="#263D78" BorderThickness="5" CornerRadius="105" Padding="24">
        <StackPanel x:Name="BubbleContent" VerticalAlignment="Center" Opacity="1" RenderTransformOrigin="0.5,0.5">
          <TextBlock x:Name="BubbleLabel" Text="账户余额" Foreground="#667DB1" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="BubbleAmount" Text="--" Foreground="#263D78" FontSize="39" FontWeight="Bold" HorizontalAlignment="Center" Width="235" Margin="0,4" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BubbleHint" Text="点击角色刷新" Foreground="#8092BC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="235"/>
        </StackPanel>
      </Border>
      <Ellipse Width="37" Height="26" Fill="White" Stroke="#263D78" StrokeThickness="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,21,34"/>
      <Ellipse Width="22" Height="16" Fill="White" Stroke="#263D78" StrokeThickness="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
    </Grid>

    <Grid x:Name="PetSurface" Canvas.Right="0" Canvas.Bottom="0" Width="238" Height="238" Panel.ZIndex="2" Background="Transparent" MouseLeftButtonDown="OnMouseLeftButtonDown" MouseLeftButtonUp="OnMouseLeftButtonUp" LostMouseCapture="OnPetLostMouseCapture" MouseMove="OnPetMouseMove" ContextMenuOpening="OnPetContextMenuOpening">
      <Grid.ContextMenu>
        <ContextMenu x:Name="PetContextMenu" Placement="MousePoint">
          <MenuItem Header="立即刷新" Click="OnContextRefreshClick"/>
          <MenuItem x:Name="BubbleMenuItem" Header="显示气泡" Click="OnContextBubbleClick"/>
          <MenuItem x:Name="InteractionMenuItem" Header="切换为锁定互动" Click="OnContextInteractionClick"/>
          <MenuItem Header="切换形象">
            <MenuItem x:Name="DeepSeekStyleMenuItem" Header="DeepSeek 小鲸鱼「澜汐」" Tag="deepseek" IsCheckable="True" Click="OnPetStyleClick"/>
            <MenuItem x:Name="ChatGptStyleMenuItem" Header="ChatGPT 小龙「霁珑」" Tag="chatgpt" IsCheckable="True" Click="OnPetStyleClick"/>
            <MenuItem x:Name="MiniMaxStyleMenuItem" Header="MiniMax 小海螺「绯音」" Tag="minimax" IsCheckable="True" Click="OnPetStyleClick"/>
            <MenuItem x:Name="GeminiStyleMenuItem" Header="Gemini 小星猫「星璃」" Tag="gemini" IsCheckable="True" Click="OnPetStyleClick"/>
          </MenuItem>
          <MenuItem x:Name="MonitorMenuItem" Header="当前账户"/>
          <Separator/>
           <MenuItem Header="配置接口" Click="OnContextSettingsClick"/>
           <MenuItem Header="检查更新" Click="OnContextUpdateClick"/>
           <MenuItem Header="用量统计" Click="OnContextUsageClick"/>
          <MenuItem Header="隐藏桌宠" Click="OnContextHideClick"/>
          <Separator/>
          <MenuItem Header="退出" Click="OnContextExitClick"/>
        </ContextMenu>
      </Grid.ContextMenu>
      <Image x:Name="PetImage" Stretch="Uniform" Margin="0,0,-6,-6" RenderTransformOrigin="0.5,0.86"
             RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="False"
             IsHitTestVisible="False"/>
      <Ellipse x:Name="StatusDot" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,27" Fill="#91A2C8" Stroke="White" StrokeThickness="3"/>
    </Grid>
  </Canvas>
</Window>
