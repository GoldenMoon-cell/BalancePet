<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalancePet.Wpf</AssemblyName>
    <RootNamespace>BalancePet.Wpf</RootNamespace>
    <ApplicationIcon>assets\balance-pet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\**\*" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
