<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalancePet.Wpf</AssemblyName>
    <RootNamespace>BalancePet.Wpf</RootNamespace>
    <Version>1.6.4</Version>
    <AssemblyVersion>1.6.4.0</AssemblyVersion>
    <FileVersion>1.6.4.0</FileVersion>
    <InformationalVersion>1.6.4</InformationalVersion>
      <ApplicationIcon>assets\balance-pet.ico</ApplicationIcon>
    <!-- User-facing packages do not need debugger files or local source paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Appearances are distributed as resource-extension packages, so a release carries
         only the built-in placeholder. The developer build keeps every folder, because
         running the app from source should not require installing packages first. The
         packer turns this on; nothing else should. -->
    <PetPackageExcludeGlob Condition="'$(ExcludePackagedPets)' == 'true'">assets\pets\**\*</PetPackageExcludeGlob>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- The self-test pins behaviour that lives behind a private implementation: the font
         guard whose narrow catch ended the process, and the download paths. Granting it
         access is cheaper than widening the API of the program just to be able to test it.
         Build-time only; nothing is exposed at run time. -->
    <InternalsVisibleTo Include="PetMigrationSelfTest" />
    <InternalsVisibleTo Include="SettingsShot" />
    <!-- Every asset that is not appearance artwork: the icon, and whatever else sits
         beside it. -->
    <Content Include="assets\**\*" Exclude="assets\pets\**" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <!-- The one appearance that cannot be missing, so it ships in every build.
         _backup-* holds local pre-resize copies of pet art and is gitignored; without
         excluding it the glob ships ~91 MB of duplicates. -->
    <Content Include="assets\pets\_placeholder\**" Exclude="assets\pets\_backup-*\**" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <!-- The packaged appearances. Left out by rule (everything under assets\pets except
         the placeholder) rather than by a list of names. The list this replaced named
         fourteen folders and went stale the moment a fifteenth appearance arrived, which
         shipped that appearance's artwork inside the installer and inside every update
         download: twenty-six megabytes of the one thing appearances-as-packages exist to
         keep out. A rule cannot go stale; a name can.
         The relationship that still needs watching is the other direction, and the
         self-test pins it: an appearance with a folder here has to be listed in
         PetStyleCatalog.Extractable, or a release would drop artwork that no package can
         then supply. -->
    <Content Include="assets\pets\**\*"
             Exclude="$(PetPackageExcludeGlob);assets\pets\_placeholder\**;assets\pets\_backup-*\**"
             LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugin-catalog.json" Link="plugin-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The AI-integration switches run these scripts from tools\ next to the
         executable. Copying them here keeps a development build behaving like a
         packaged one, where the release script stages the same files. -->
    <Content Include="..\..\tools\balancepet-client-hook.ps1" Link="tools\balancepet-client-hook.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\balancepet-task.ps1" Link="tools\balancepet-task.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\balancepet-task.cmd" Link="tools\balancepet-task.cmd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\install-balancepet-client-hooks.ps1" Link="tools\install-balancepet-client-hooks.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\install-balancepet-dsh-plugin.ps1" Link="tools\install-balancepet-dsh-plugin.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\dsh-bridge\package.json" Link="tools\dsh-bridge\package.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\dsh-bridge\lib\index.js" Link="tools\dsh-bridge\lib\index.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
