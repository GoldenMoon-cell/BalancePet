<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalancePet.Wpf</AssemblyName>
    <RootNamespace>BalancePet.Wpf</RootNamespace>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <InformationalVersion>0.9.1</InformationalVersion>
    <ApplicationIcon>assets\balance-pet.ico</ApplicationIcon>
    <!-- User-facing packages do not need debugger files or local source paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <Content Include="assets\**\*" Exclude="assets\**\*.key-v2" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugin-catalog.json" Link="plugin-catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
