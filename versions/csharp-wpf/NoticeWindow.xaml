<Window x:Class="BalancePet.Wpf.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalancePet.Wpf.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小余额更新记录" Width="580" Height="620" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        Background="Transparent"
        FontFamily="{DynamicResource UiFontFamily}" SnapsToDevicePixels="True" UseLayoutRounding="True"
        SourceInitialized="OnWindowSourceInitialized">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/FluentControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#42EBF1F0"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#A8DFE8E6"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#8FFFFFFF"/>
      <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#D9FFFFFF"/>
      <SolidColorBrush x:Key="TextBrush" Color="#1C292B"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#637174"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#383B4B4E"/>
      <SolidColorBrush x:Key="ControlBrush" Color="#EFFFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#13766F"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F13766F"/>
      <SolidColorBrush x:Key="FocusBrush" Color="#6613766F"/>
      <sys:Double x:Key="ThemeControlHeight">32</sys:Double>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
      </Style>
      <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar. Behaves like a window: drag to move, buttons on the right. -->
      <Grid Grid.Row="0" Height="48">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="更新记录" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <Border x:Name="UnreadBadge" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                  VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="UnreadBadgeText" Foreground="White" FontSize="11"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="最小化">
            <Path Data="M0,0 H10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnCloseClick" ToolTip="关闭">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- One line saying what this list is, and what it is not. -->
      <TextBlock Grid.Row="1" x:Name="IntroText" Margin="16,0,16,10" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource MutedBrush}"
                 Text="规范、文档和在线内容的变更会记在这里。主程序与扩展的版本更新由「检查更新」负责，不会重复出现在这里。"/>

      <Grid Grid.Row="2" Margin="16,0,16,0">
        <ScrollViewer x:Name="NoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NoticeList"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Top"
                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                   Text="还没有读到更新记录。首次联网后会自动获取；如果一直为空，可以用下面的「刷新」重试。"/>
      </Grid>

      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <local:ToggleSwitch x:Name="NotifyBox" Content="有新内容时让桌宠提醒我" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged"/>
            <TextBlock x:Name="NotifyHintText" Text="关掉之后仍然会记录，只是不再主动弹出气泡。" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Content="刷新" Padding="12,6" Margin="0,0,8,0" Click="OnRefreshClick"/>
            <Button x:Name="CloseFooterButton" Content="关闭" Padding="16,6" Click="OnCloseClick"
                    Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
