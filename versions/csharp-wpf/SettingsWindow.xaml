<Window x:Class="BalancePet.Wpf.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小余额设置" Width="520" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="余额 API 地址"/><TextBox x:Name="EndpointBox" Margin="0,4,0,2"/>
      <TextBlock Text="填写中转站文档中的余额查询 URL，不是网站首页或聊天接口。" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="认证方式"/><ComboBox x:Name="AuthModeBox" SelectionChanged="OnAuthModeChanged" Margin="0,4,0,2">
        <ComboBoxItem Tag="bearer">Bearer Token（只填令牌）</ComboBoxItem><ComboBoxItem Tag="authorization">完整 Authorization（需含 Bearer）</ComboBoxItem><ComboBoxItem Tag="websee-session">中转站会话（websee-session）</ComboBoxItem><ComboBoxItem Tag="x-api-key">x-api-key</ComboBoxItem><ComboBoxItem Tag="custom">自定义 Header</ComboBoxItem>
      </ComboBox>
      <TextBlock x:Name="AuthHint" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="自定义 Header 名"/><TextBox x:Name="HeaderBox" Margin="0,4,0,12"/>
      <TextBlock Text="访问令牌（留空保持现有令牌）"/><PasswordBox x:Name="TokenBox" Margin="0,4,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="余额 JSON 路径"/><TextBox x:Name="PathBox" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="货币"/><TextBox x:Name="CurrencyBox" Margin="0,4,0,12"/></StackPanel></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="刷新秒数（最少 30）"/><TextBox x:Name="RefreshBox" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="低余额阈值"/><TextBox x:Name="ThresholdBox" Margin="0,4,0,12"/></StackPanel></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="宠物形象"/><ComboBox x:Name="PetStyleBox" Margin="0,4,0,12"><ComboBoxItem Tag="deepseek" ToolTip="DeepSeek 小鲸鱼 / Whale-chan / 澜汐">DeepSeek 小鲸鱼「澜汐」</ComboBoxItem><ComboBoxItem Tag="chatgpt" ToolTip="GPT 小龙 / GPT Dragon / 霁珑">GPT 小龙「霁珑」</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="交互模式"/><ComboBox x:Name="InteractionBox" Margin="0,4,0,12"><ComboBoxItem Tag="free">自由拖动</ComboBoxItem><ComboBoxItem Tag="locked">锁定互动</ComboBoxItem></ComboBox></StackPanel></Grid>
      <TextBlock Text="自动检查更新"/><ComboBox x:Name="UpdateCheckBox" Margin="0,4,0,12"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="桌宠大小"/><Slider x:Name="ScaleSlider" Minimum="0.6" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="音量"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel></Grid>
      <WrapPanel Margin="0,0,0,12"><CheckBox x:Name="SoundBox" Content="按压音效" Margin="0,0,18,8"/><CheckBox x:Name="BubbleBox" Content="对话气泡" Margin="0,0,18,8"/><CheckBox x:Name="InteractionEffectsBox" Content="互动动作" Margin="0,0,18,8"/><CheckBox x:Name="EasterEggsBox" Content="随机彩蛋" Margin="0,0,18,8"/><CheckBox x:Name="FollowCodexBox" Content="跟随 Codex 显示/隐藏" Margin="0,0,18,8"/><CheckBox x:Name="NotificationsBox" Content="系统通知" Margin="0,0,18,8"/></WrapPanel>
      <CheckBox x:Name="StartupBox" Content="随 Windows 启动（进入托盘）" Margin="0,0,0,12"/>
      <TextBlock x:Name="MessageText" Foreground="#C43B52" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="导入设置" Click="OnImport" Padding="12,7" Margin="0,0,6,0"/>
        <Button Content="导出设置" Click="OnExport" Padding="12,7"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="OnCancel" Padding="18,7" Margin="0,0,8,0"/>
        <Button Content="保存并测试" Click="OnSave" Padding="18,7" Background="#263D78" Foreground="White"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
