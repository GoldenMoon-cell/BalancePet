<Window x:Class="BalancePet.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小余额设置" Width="760" Height="720" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None" AllowDrop="True" Drop="OnExtensionDrop" DragOver="OnExtensionDragOver"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="OnWindowLoaded" SourceInitialized="OnWindowSourceInitialized">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/FluentControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#42EBF1F0"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#A8DFE8E6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#8FFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C292B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#637174"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#383B4B4E"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#EFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#13766F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F13766F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#8CEFE0BF"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#785123"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#6613766F"/>
    <CornerRadius x:Key="ThemeCornerRadius">8</CornerRadius>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ThemeSectionSpacing">18</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ThemeControlHeight">32</system:Double>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ExtensionActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CatalogActionButton" TargetType="Button" BasedOn="{StaticResource ExtensionActionButton}">
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TabPanel Grid.Column="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
              <Border Grid.Column="1" Background="{TemplateBinding Background}" Padding="16,2,2,2">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Width" Value="166"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,2,10,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
              <Grid>
                <Border x:Name="SelectionIndicator" Width="3" Height="16" Margin="-9,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                <ContentPresenter ContentSource="Header" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentBrush}">
            <Image Source="pack://siteoforigin:,,,/assets/balance-pet.ico" Width="17" Height="17" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="BalancePet" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0"/>
          <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="9,0"/>
          <TextBlock Text="设置" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化">
            <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreWindow" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原">
            <Path Data="M 1.5,1.5 L 10.5,1.5 10.5,10.5 1.5,10.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent"/>
          </Button>
          <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭">
            <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Border Width="188" HorizontalAlignment="Left" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"/>
      <Grid Margin="10,12,20,12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl Grid.Row="0" TabStripPlacement="Left" Padding="2"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                SelectionChanged="OnTabSelectionChanged">
      <TabItem Header="账户与接口">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="监控账户" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,5,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfileBox" SelectionChanged="OnProfileSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,0,6,0"/>
              <Button Grid.Column="1" Content="新增" Click="OnAddProfile" Padding="10,4" Margin="0,0,6,0"/>
              <Button Grid.Column="2" Content="删除" Click="OnDeleteProfile" Padding="10,4" Margin="0,0,6,0"/>
              <CheckBox x:Name="MonitorEnabledBox" Grid.Column="3" Content="启用" VerticalAlignment="Center" Checked="OnMonitorEnabledChanged" Unchecked="OnMonitorEnabledChanged"/>
            </Grid>
            <TextBox x:Name="ProfileNameBox" TextChanged="OnProfileNameChanged" ToolTip="给这个余额账户起一个容易识别的名称" Margin="0,0,0,14"/>

            <Border x:Name="AccountSummaryCard" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="当前账户" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="AccountSummaryNameText" Text="默认账户" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                  <TextBlock x:Name="AccountSummaryHintText" Text="余额接口尚未配置" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Top">
                  <TextBlock x:Name="AccountSummaryStatusText" Text="已启用" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
              </Grid>
            </Border>

            <TextBlock Text="接口预设"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="auto">自动识别（推荐）</ComboBoxItem>
              <ComboBoxItem Tag="v1-usage">通用 /v1/usage</ComboBoxItem>
              <ComboBoxItem Tag="new-api-token">New API /api/usage/token</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义接口</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="PresetHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="SiteUrlLabel" Text="中转站地址"/>
            <TextBox x:Name="SiteUrlBox" TextChanged="OnSiteUrlChanged" Margin="0,5,0,2"/>
            <TextBlock x:Name="SiteUrlHint" Text="只填写站点根地址，例如 https://example.com；程序会自动补全余额接口。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="余额 API 地址"/>
            <TextBox x:Name="EndpointBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,2"/>
            <TextBlock x:Name="EndpointHint" Text="填写中转站文档中的余额查询 URL，不是网站首页或聊天接口。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="认证方式"/>
            <ComboBox x:Name="AuthModeBox" SelectionChanged="OnAuthModeChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="bearer">Bearer Token（只填令牌）</ComboBoxItem>
              <ComboBoxItem Tag="authorization">完整 Authorization（需含 Bearer）</ComboBoxItem>
              <ComboBoxItem Tag="websee-session">中转站会话（websee-session）</ComboBoxItem>
              <ComboBoxItem Tag="x-api-key">x-api-key</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义 Header</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="AuthHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>

            <TextBlock Text="自定义 Header 名"/>
            <TextBox x:Name="HeaderBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/>
            <TextBlock Text="访问令牌（留空保持现有令牌；无令牌时跳过测试）" TextWrapping="Wrap"/>
            <PasswordBox x:Name="TokenBox" PasswordChanged="OnSettingPasswordChanged" Margin="0,5,0,12"/>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="余额 JSON 路径"/><TextBox x:Name="PathBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="货币"/><TextBox x:Name="CurrencyBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="自动刷新间隔"/>
                <ComboBox x:Name="RefreshBox" SelectionChanged="OnRefreshModeChanged" DropDownClosed="OnComboDropDownClosed" ToolTip="仅控制自动刷新；手动刷新固定至少间隔 5 秒" Margin="0,5,0,2">
                  <ComboBoxItem Tag="off">关闭自动刷新</ComboBoxItem><ComboBoxItem Tag="30">每 30 秒</ComboBoxItem><ComboBoxItem Tag="60">每 1 分钟</ComboBoxItem><ComboBoxItem Tag="300">每 5 分钟</ComboBoxItem><ComboBoxItem Tag="900">每 15 分钟</ComboBoxItem><ComboBoxItem Tag="1800">每 30 分钟</ComboBoxItem><ComboBoxItem Tag="3600">每 1 小时</ComboBoxItem><ComboBoxItem Tag="custom">自定义</ComboBoxItem>
                </ComboBox>
                <TextBox x:Name="RefreshCustomBox" TextChanged="OnSettingTextChanged" Visibility="Collapsed" ToolTip="请输入自动刷新秒数，最少 30 秒" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="低余额阈值"/><TextBox x:Name="ThresholdBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/></StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="桌宠与交互">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="外观与操作" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,8,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="宠物形象"/>
            <ComboBox x:Name="PetStyleBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,12">
                  <ComboBoxItem Tag="deepseek" ToolTip="DeepSeek 小鲸鱼 / Whale-chan / 澜汐">DeepSeek 小鲸鱼「澜汐」</ComboBoxItem>
                  <ComboBoxItem Tag="chatgpt" ToolTip="ChatGPT 小白龙 / ChatGPT White Dragon / 霁珑">ChatGPT 小白龙「霁珑」</ComboBoxItem>
                  <ComboBoxItem Tag="minimax" ToolTip="MiniMax 小海螺 / 绯音">MiniMax 小海螺「绯音」</ComboBoxItem>
                  <ComboBoxItem Tag="gemini" ToolTip="Gemini 小星猫 / 星璃">Gemini 小星猫「星璃」</ComboBoxItem>
                  <ComboBoxItem Tag="grok" ToolTip="Grok 小恶魔 / Grok Little Demon / 烬斧">Grok 小恶魔「烬斧」</ComboBoxItem>
                  <ComboBoxItem Tag="claude" ToolTip="Claude 小书灵 / Little Book Spirit / 丹笺">Claude 小书灵「丹笺」</ComboBoxItem>
                  <ComboBoxItem Tag="kimi" ToolTip="Kimi 小棱镜 / Little Prism / 虹谱">Kimi 小棱镜「虹谱」</ComboBoxItem>
                  <ComboBoxItem Tag="qwen" ToolTip="Qwen 小折扇 / Folding Fan / 绀华">Qwen 小折扇「绀华」</ComboBoxItem>
                  <ComboBoxItem Tag="ernie">Ernie 小病书灵「青绡」</ComboBoxItem>
                  <ComboBoxItem Tag="glm">GLM 小方灵「青棱」</ComboBoxItem>
                  <ComboBoxItem Tag="gpt-image2">GPT Image 2 小墨龙「玄珏」</ComboBoxItem>
                  <ComboBoxItem Tag="llama">Llama 小羊驼「绒眠」</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="交互模式"/><ComboBox x:Name="InteractionBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,12"><ComboBoxItem Tag="free">自由拖动</ComboBoxItem><ComboBoxItem Tag="locked">锁定互动</ComboBoxItem></ComboBox></StackPanel>
            </Grid>

            <Grid Margin="0,2,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="桌宠大小"/><Slider x:Name="ScaleSlider" ValueChanged="OnSettingValueChanged" Minimum="0.6" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="音量"/><Slider x:Name="VolumeSlider" ValueChanged="OnSettingValueChanged" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel>
            </Grid>

            <TextBlock Text="功能开关" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,8"/>
            <StackPanel>
              <CheckBox x:Name="SoundBox" Content="按压音效" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="BubbleBox" Content="对话气泡" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="InteractionEffectsBox" Content="互动动作" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="EasterEggsBox" Content="随机彩蛋" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="FollowCodexBox" Content="自动跟随 AI 任务" ToolTip="兼容 Codex Hook 和其他客户端调用；只传递开始、结束、客户端名和任务 ID，不读取提示词、回复或令牌" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="AccountStatusBox" Content="读取 CC Switch 当前账户" ToolTip="只读读取 CC Switch 当前供应商；令牌只在本机内存中计算指纹，不读取网页登录凭据或上传明文令牌" Checked="OnAccountStatusChanged" Unchecked="OnAccountStatusChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="NotificationsBox" Content="系统通知" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <CheckBox x:Name="StartupBox" Content="随 Windows 启动（进入托盘）" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,12"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="扩展">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="ExtensionManagementTitleText" Text="扩展管理" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="ExtensionManagementHintText" Text="在线插件库负责发现扩展；功能扩展安装即启用，后台能力会自动运行。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="PluginCatalogTitleText" Text="在线插件库" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="PluginCatalogHintText" Text="从 BalancePet 官方目录发现插件；下载后仍会执行本地安全校验。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="PluginCatalogRefreshButton" Grid.Column="1" Content="刷新目录" Click="OnRefreshPluginCatalog" ToolTip="刷新在线插件目录" Padding="10,5" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="PluginCatalogSearchBox" Height="29" ToolTip="搜索插件名称、作者或分类" TextChanged="OnPluginCatalogSearchChanged"/>
                  <TextBlock Grid.Column="1" x:Name="PluginCatalogCountText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <ListBox x:Name="PluginCatalogListBox" Height="218" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" Margin="0,2" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="32" Height="32" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" VerticalAlignment="Top">
                            <Image Source="pack://siteoforigin:,,,/assets/balance-pet.ico" Width="22" Height="22" Stretch="Uniform"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="{Binding ActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallPluginCatalogItem" IsEnabled="{Binding CanInstall}" Style="{StaticResource CatalogActionButton}"/>
                            <Button Content="{Binding RepositoryText}" Click="OnOpenPluginCatalogRepository" ToolTip="{Binding RepositoryText}" Padding="4,3" Margin="0,5,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="PluginCatalogStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="LocalExtensionsTitleText" Text="本地扩展" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="LocalExtensionsHintText" Text="已下载到扩展库的 ZIP 会显示在这里；扫描到不代表已经安装。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <ListBox x:Name="ExtensionListBox" AllowDrop="True" Drop="OnExtensionDrop" DragOver="OnExtensionDragOver" MinHeight="280" Height="360" SelectionChanged="OnExtensionSelectionChanged" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" Padding="7" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="9,8" Margin="0,2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding InstallActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallOrUninstallExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding CanInstallOrUninstall}"/>
                        <Button Content="{Binding ToggleActionText}" ToolTip="{Binding ToggleTooltip}" Click="OnToggleExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding IsInstalled}" Visibility="{Binding ToggleVisibility}"/>
                        <Button Content="{Binding UpdateActionText}" ToolTip="{Binding UpdateTooltip}" Click="OnUpdateExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding HasUpdate}"/>
                        <Button Content="{Binding LaunchActionText}" ToolTip="{Binding LaunchTooltip}" Click="OnLaunchExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding CanLaunch}" Visibility="{Binding LaunchVisibility}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="扩展库操作" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,5"/>
            <WrapPanel Margin="0,0,0,7">
              <Button x:Name="ExtensionScanButton" Content="扫描库" ToolTip="扫描扩展库" Click="OnScanExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionOpenButton" Content="打开文件夹" ToolTip="打开扩展库" Click="OnOpenExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionImportButton" Content="导入 ZIP" ToolTip="导入 ZIP 到扩展库" Click="OnInstallExtension" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionCleanupButton" Content="清理旧版" ToolTip="删除旧版扩展资源，保留当前版本" Click="OnCleanupExtensionResources" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionCheckButton" Content="检查更新" ToolTip="检查扩展更新" Click="OnCheckExtensionUpdates" Padding="10,5"/>
            </WrapPanel>
            <TextBlock x:Name="ExtensionUpdateStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock x:Name="ExtensionMessageText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="10" CornerRadius="4">
              <TextBlock Text="扩展不会写入主程序安装目录。禁用或卸载当前正在使用的资源扩展后，桌宠会回退到内置形象；功能扩展始终在独立进程中运行。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="外观">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="4,0,2,16">
            <TextBlock Text="主题插件" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="外观" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="让设置窗口融入 Windows，同时保持信息清晰、操作安静。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18"/>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="14" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                  <Path Data="M 9,4 L 17,4 21,8 21,16 17,20 9,20 5,16 5,8 Z M 9,8 L 17,8 M 9,12 L 17,12 M 9,16 L 14,16" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Margin="10"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                  <TextBlock x:Name="CurrentThemeNameText" Text="BalancePet 云母" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CurrentThemeDescriptionText" Text="系统云母底层、Fluent 控件与 BalancePet 青绿色强调色。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock x:Name="CurrentThemeMetaText" Text="主题扩展 · v1.0.0 · GoldenMoon" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,3" VerticalAlignment="Top">
                  <TextBlock Text="已启用" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </Border>

            <TextBlock Text="当前主题" FontWeight="SemiBold"/>
            <ComboBox x:Name="ThemeBox" SelectionChanged="OnThemeSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,16"/>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="颜色模式" FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeModeBox" SelectionChanged="OnThemeOptionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,0">
                  <ComboBoxItem Tag="system">跟随系统</ComboBoxItem>
                  <ComboBoxItem Tag="light">浅色</ComboBoxItem>
                  <ComboBoxItem Tag="dark">深色</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="窗口材质" FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeBackdropBox" SelectionChanged="OnThemeOptionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,0">
                  <ComboBoxItem Tag="mica" ToolTip="Windows 11 主窗口材质，背景更柔和。">云母（推荐）</ComboBoxItem>
                  <ComboBoxItem Tag="mica-alt" ToolTip="更浓、更有层次，适合侧栏和标签式窗口。">云母 Alt（更浓）</ComboBoxItem>
                  <ComboBoxItem Tag="acrylic" ToolTip="半透明亚克力玻璃效果。">亚克力</ComboBoxItem>
                  <ComboBoxItem Tag="solid" ToolTip="关闭透明材质，使用主题的纯色背景。">实色</ComboBoxItem>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="紧凑布局" FontWeight="SemiBold"/>
                  <TextBlock Text="在相同窗口中显示更多设置项。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ThemeCompactBox" Grid.Column="1" VerticalAlignment="Center" Checked="OnThemeCompactChanged" Unchecked="OnThemeCompactChanged"/>
              </Grid>
            </Border>

            <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
              <TextBlock Text="Windows 11 使用云母，Windows 10 使用 Acrylic；高对比度或关闭透明效果时自动回退为实色。" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button Content="打开主题目录" Click="OnOpenThemeDirectory" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="导入主题 ZIP" Click="OnImportThemePackage" Padding="12,6"/>
            </StackPanel>
            <TextBlock x:Name="ThemeMessageText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="高级与迁移">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="应用偏好" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="自动检查更新" Margin="0,12,0,0"/>
            <ComboBox x:Name="UpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="自动检查扩展更新"/>
            <ComboBox x:Name="ExtensionUpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="语言"/>
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,18"><ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem></ComboBox>

            <Separator Margin="0,0,0,14"/>
            <TextBlock Text="设置迁移" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="导出文件不包含访问令牌。迁移到其他用户或电脑后，需要重新填写令牌。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
            <WrapPanel>
              <Button Content="导入设置" Click="OnImport" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="导出设置" Click="OnExport" Padding="12,6"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="28" Margin="196,0,0,6"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="OnCancel" Padding="18,7" Margin="0,0,8,0"/>
      <Button Content="确定" Click="OnOk" Padding="18,7" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
      <Button Content="应用" Click="OnApply" Padding="18,7"/>
    </StackPanel>

    <Grid x:Name="UnsavedOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="20" Background="#660E1729">
      <Border Width="380" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel>
          <TextBlock x:Name="UnsavedDialogTitleText" Text="未保存的设置" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="UnsavedDialogMessageText" Text="设置尚未保存，确定放弃更改并关闭吗？" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UnsavedKeepEditingButton" Content="继续编辑" Click="OnKeepEditingClick" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="UnsavedDiscardButton" Content="放弃更改" Click="OnDiscardChangesClick" Padding="12,6" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
