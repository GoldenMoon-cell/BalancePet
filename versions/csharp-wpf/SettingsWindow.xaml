<Window x:Class="BalancePet.Wpf.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小余额设置" Width="640" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6FB" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True" Loaded="OnWindowLoaded">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#26324D"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#71809D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D7DFEE"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FBFCFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#344F91"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FA"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#8EA9DF"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="29"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="29"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="7,2"/>
      <!-- Keep the closed selection display deterministic while allowing the
           user to open the list and choose an item. -->
      <Setter Property="IsEditable" Value="True"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Background" Value="#EEF2FA"/>
      <Setter Property="BorderBrush" Value="#C9D3E7"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E2E9F7"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D5E0F3"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ExtensionActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CatalogActionButton" TargetType="Button" BasedOn="{StaticResource ExtensionActionButton}">
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="14,14,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Margin="0,0,0,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
    <TabControl Padding="2" SelectionChanged="OnTabSelectionChanged">
      <TabItem Header="账户与接口">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2">
            <TextBlock Text="监控账户" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,5,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfileBox" SelectionChanged="OnProfileSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,0,6,0"/>
              <Button Grid.Column="1" Content="新增" Click="OnAddProfile" Padding="10,4" Margin="0,0,6,0"/>
              <Button Grid.Column="2" Content="删除" Click="OnDeleteProfile" Padding="10,4" Margin="0,0,6,0"/>
              <CheckBox x:Name="MonitorEnabledBox" Grid.Column="3" Content="启用" VerticalAlignment="Center"/>
            </Grid>
            <TextBox x:Name="ProfileNameBox" TextChanged="OnProfileNameChanged" ToolTip="给这个余额账户起一个容易识别的名称" Margin="0,0,0,14"/>

            <TextBlock Text="接口预设"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="auto">自动识别（推荐）</ComboBoxItem>
              <ComboBoxItem Tag="v1-usage">通用 /v1/usage</ComboBoxItem>
              <ComboBoxItem Tag="new-api-token">New API /api/usage/token</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义接口</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="PresetHint" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="SiteUrlLabel" Text="中转站地址"/>
            <TextBox x:Name="SiteUrlBox" TextChanged="OnSiteUrlChanged" Margin="0,5,0,2"/>
            <TextBlock x:Name="SiteUrlHint" Text="只填写站点根地址，例如 https://example.com；程序会自动补全余额接口。" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="余额 API 地址"/>
            <TextBox x:Name="EndpointBox" Margin="0,5,0,2"/>
            <TextBlock x:Name="EndpointHint" Text="填写中转站文档中的余额查询 URL，不是网站首页或聊天接口。" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="认证方式"/>
            <ComboBox x:Name="AuthModeBox" SelectionChanged="OnAuthModeChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="bearer">Bearer Token（只填令牌）</ComboBoxItem>
              <ComboBoxItem Tag="authorization">完整 Authorization（需含 Bearer）</ComboBoxItem>
              <ComboBoxItem Tag="websee-session">中转站会话（websee-session）</ComboBoxItem>
              <ComboBoxItem Tag="x-api-key">x-api-key</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义 Header</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="AuthHint" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>

            <TextBlock Text="自定义 Header 名"/>
            <TextBox x:Name="HeaderBox" Margin="0,5,0,12"/>
            <TextBlock Text="访问令牌（留空保持现有令牌；无令牌时跳过测试）" TextWrapping="Wrap"/>
            <PasswordBox x:Name="TokenBox" Margin="0,5,0,12"/>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="余额 JSON 路径"/><TextBox x:Name="PathBox" Margin="0,5,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="货币"/><TextBox x:Name="CurrencyBox" Margin="0,5,0,12"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="自动刷新间隔"/>
                <ComboBox x:Name="RefreshBox" SelectionChanged="OnRefreshModeChanged" DropDownClosed="OnComboDropDownClosed" ToolTip="仅控制自动刷新；手动刷新固定至少间隔 5 秒" Margin="0,5,0,2">
                  <ComboBoxItem Tag="off">关闭自动刷新</ComboBoxItem><ComboBoxItem Tag="30">每 30 秒</ComboBoxItem><ComboBoxItem Tag="60">每 1 分钟</ComboBoxItem><ComboBoxItem Tag="300">每 5 分钟</ComboBoxItem><ComboBoxItem Tag="900">每 15 分钟</ComboBoxItem><ComboBoxItem Tag="1800">每 30 分钟</ComboBoxItem><ComboBoxItem Tag="3600">每 1 小时</ComboBoxItem><ComboBoxItem Tag="custom">自定义</ComboBoxItem>
                </ComboBox>
                <TextBox x:Name="RefreshCustomBox" Visibility="Collapsed" ToolTip="请输入自动刷新秒数，最少 30 秒" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="低余额阈值"/><TextBox x:Name="ThresholdBox" Margin="0,5,0,12"/></StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="桌宠与交互">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2">
            <TextBlock Text="外观与操作" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,8,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="宠物形象"/>
            <ComboBox x:Name="PetStyleBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,12">
                  <ComboBoxItem Tag="deepseek" ToolTip="DeepSeek 小鲸鱼 / Whale-chan / 澜汐">DeepSeek 小鲸鱼「澜汐」</ComboBoxItem>
                  <ComboBoxItem Tag="chatgpt" ToolTip="ChatGPT 小白龙 / ChatGPT White Dragon / 霁珑">ChatGPT 小白龙「霁珑」</ComboBoxItem>
                  <ComboBoxItem Tag="minimax" ToolTip="MiniMax 小海螺 / 绯音">MiniMax 小海螺「绯音」</ComboBoxItem>
                  <ComboBoxItem Tag="gemini" ToolTip="Gemini 小星猫 / 星璃">Gemini 小星猫「星璃」</ComboBoxItem>
                  <ComboBoxItem Tag="grok" ToolTip="Grok 小恶魔 / Grok Little Demon / 烬斧">Grok 小恶魔「烬斧」</ComboBoxItem>
                  <ComboBoxItem Tag="claude" IsEnabled="False" ToolTip="素材尚未完成">Claude 小书灵「丹笺」</ComboBoxItem>
                  <ComboBoxItem Tag="kimi" IsEnabled="False" ToolTip="素材尚未完成">Kimi 小棱镜「虹谱」</ComboBoxItem>
                  <ComboBoxItem Tag="qwen" IsEnabled="False" ToolTip="素材尚未完成">Qwen 小折扇「绀华」</ComboBoxItem>
                  <ComboBoxItem Tag="ernie" IsEnabled="False" ToolTip="素材尚未完成">Ernie 小病书灵「青绡」</ComboBoxItem>
                  <ComboBoxItem Tag="glm" IsEnabled="False" ToolTip="素材尚未完成">GLM 小方灵「青棱」</ComboBoxItem>
                  <ComboBoxItem Tag="gpt-image2" IsEnabled="False" ToolTip="素材尚未完成">GPT Image 2 小墨龙「玄珏」</ComboBoxItem>
                  <ComboBoxItem Tag="llama" IsEnabled="False" ToolTip="素材尚未完成">Llama 小羊驼「绒眠」</ComboBoxItem>
                  <ComboBoxItem Tag="mimo" IsEnabled="False" ToolTip="素材尚未完成">MiMo 小兔码师「橙析」</ComboBoxItem>
                  <ComboBoxItem Tag="mistral" IsEnabled="False" ToolTip="素材尚未完成">Mistral 小猫骑士「麦霜」</ComboBoxItem>
                  <ComboBoxItem Tag="opencode" IsEnabled="False" ToolTip="素材尚未完成">OpenCode 小码灵「墨枢」</ComboBoxItem>
                  <ComboBoxItem Tag="perplexity" IsEnabled="False" ToolTip="素材尚未完成">Perplexity 小探灯「青鉴」</ComboBoxItem>
                  <ComboBoxItem Tag="rwkv" IsEnabled="False" ToolTip="素材尚未完成">RWKV 小乌鸦「夜翎」</ComboBoxItem>
                  <ComboBoxItem Tag="seedence" IsEnabled="False" ToolTip="素材尚未完成">Seedence 小星晶「澄芽」</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="交互模式"/><ComboBox x:Name="InteractionBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,12"><ComboBoxItem Tag="free">自由拖动</ComboBoxItem><ComboBoxItem Tag="locked">锁定互动</ComboBoxItem></ComboBox></StackPanel>
            </Grid>

            <Grid Margin="0,2,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="桌宠大小"/><Slider x:Name="ScaleSlider" Minimum="0.6" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="音量"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,12"/></StackPanel>
            </Grid>

            <TextBlock Text="功能开关" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,8"/>
            <StackPanel>
              <CheckBox x:Name="SoundBox" Content="按压音效" Margin="0,0,0,9"/>
              <CheckBox x:Name="BubbleBox" Content="对话气泡" Margin="0,0,0,9"/>
              <CheckBox x:Name="InteractionEffectsBox" Content="互动动作" Margin="0,0,0,9"/>
              <CheckBox x:Name="EasterEggsBox" Content="随机彩蛋" Margin="0,0,0,9"/>
              <CheckBox x:Name="FollowCodexBox" Content="自动跟随 AI 任务" ToolTip="兼容 Codex Hook 和其他客户端调用；只传递开始、结束、客户端名和任务 ID，不读取提示词、回复或令牌" Margin="0,0,0,9"/>
              <CheckBox x:Name="AccountStatusBox" Content="识别 AI 登录账户" ToolTip="客户端仅上报账户类型、API 地址和令牌指纹；BalancePet 不读取网页登录凭据或明文令牌" Margin="0,0,0,9"/>
              <CheckBox x:Name="NotificationsBox" Content="系统通知" Margin="0,0,0,9"/>
              <CheckBox x:Name="StartupBox" Content="随 Windows 启动（进入托盘）" Margin="0,0,0,12"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="扩展">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="ExtensionManagementTitleText" Text="扩展管理" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="ExtensionManagementHintText" Text="在线插件库负责发现扩展，本地扩展区负责安装、启用、更新和启动。" Foreground="#71809D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <Border Background="#F7F9FE" BorderBrush="#D7DFEE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="PluginCatalogTitleText" Text="在线插件库" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="PluginCatalogHintText" Text="从 BalancePet 官方目录发现插件；下载后仍会执行本地安全校验。" Foreground="#71809D" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="PluginCatalogRefreshButton" Grid.Column="1" Content="刷新目录" Click="OnRefreshPluginCatalog" ToolTip="刷新在线插件目录" Padding="10,5" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="PluginCatalogSearchBox" Height="29" ToolTip="搜索插件名称、作者或分类" TextChanged="OnPluginCatalogSearchChanged"/>
                  <TextBlock Grid.Column="1" x:Name="PluginCatalogCountText" Foreground="#71809D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <ListBox x:Name="PluginCatalogListBox" Height="218" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" Margin="0,2" Background="White" BorderBrush="#D7DFEE" BorderThickness="1" CornerRadius="7">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="32" Height="32" Background="#EEF2FA" CornerRadius="8" VerticalAlignment="Top">
                            <Image Source="pack://siteoforigin:,,,/assets/balance-pet.ico" Width="22" Height="22" Stretch="Uniform"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Foreground="#53627F" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding MetaText}" Foreground="#71809D" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#344F91" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="{Binding ActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallPluginCatalogItem" IsEnabled="{Binding CanInstall}" Style="{StaticResource CatalogActionButton}"/>
                            <Button Content="{Binding RepositoryText}" Click="OnOpenPluginCatalogRepository" ToolTip="{Binding RepositoryText}" Padding="4,3" Margin="0,5,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" FontSize="10"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="PluginCatalogStatusText" Foreground="#71809D" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="LocalExtensionsTitleText" Text="本地扩展" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="LocalExtensionsHintText" Text="已下载到扩展库的 ZIP 会显示在这里；扫描到不代表已经安装。" Foreground="#71809D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <ListBox x:Name="ExtensionListBox" MinHeight="280" Height="360" SelectionChanged="OnExtensionSelectionChanged" BorderBrush="#D7DFEE" BorderThickness="1" Padding="7" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="9,8" Margin="0,2" Background="#F8FAFF" BorderBrush="#D7DFEE" BorderThickness="1" CornerRadius="7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="#71809D" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding InstallActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallOrUninstallExtension" Style="{StaticResource ExtensionActionButton}"/>
                        <Button Content="{Binding ToggleActionText}" ToolTip="{Binding ToggleTooltip}" Click="OnToggleExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding IsInstalled}"/>
                        <Button Content="{Binding UpdateActionText}" ToolTip="{Binding UpdateTooltip}" Click="OnUpdateExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding HasUpdate}"/>
                        <Button Content="{Binding LaunchActionText}" ToolTip="{Binding LaunchTooltip}" Click="OnLaunchExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding CanLaunch}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="扩展库操作" Foreground="#71809D" FontSize="11" Margin="0,9,0,5"/>
            <WrapPanel Margin="0,0,0,7">
              <Button x:Name="ExtensionScanButton" Content="扫描库" ToolTip="扫描扩展库" Click="OnScanExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionOpenButton" Content="打开文件夹" ToolTip="打开扩展库" Click="OnOpenExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionImportButton" Content="导入 ZIP" ToolTip="导入 ZIP 到扩展库" Click="OnInstallExtension" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionCheckButton" Content="检查更新" ToolTip="检查扩展更新" Click="OnCheckExtensionUpdates" Padding="10,5"/>
            </WrapPanel>
            <TextBlock x:Name="ExtensionUpdateStatusText" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock x:Name="ExtensionMessageText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Background="#F4F6FA" Padding="10" CornerRadius="4">
              <TextBlock Text="扩展不会写入主程序安装目录。禁用或卸载当前正在使用的资源扩展后，桌宠会回退到内置形象；功能扩展始终在独立进程中运行。" Foreground="#53627F" FontSize="11" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="高级与迁移">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2">
            <TextBlock Text="应用偏好" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="自动检查更新" Margin="0,12,0,0"/>
            <ComboBox x:Name="UpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="自动检查扩展更新"/>
            <ComboBox x:Name="ExtensionUpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="语言"/>
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,18"><ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem></ComboBox>

            <Separator Margin="0,0,0,14"/>
            <TextBlock Text="设置迁移" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="导出文件不包含访问令牌。迁移到其他用户或电脑后，需要重新填写令牌。" Foreground="#7885A3" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
            <WrapPanel>
              <Button Content="导入设置" Click="OnImport" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="导出设置" Click="OnExport" Padding="12,6"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    </Border>

    <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="#C43B52" TextWrapping="Wrap" MinHeight="28" Margin="0,0,0,6"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="OnCancel" Padding="18,7" Margin="0,0,8,0"/>
      <Button Content="确定" Click="OnOk" Padding="18,7" Margin="0,0,8,0" Background="#263D78" Foreground="White"/>
      <Button Content="应用" Click="OnApply" Padding="18,7"/>
    </StackPanel>
  </Grid>
</Window>
