<Window x:Class="BalancePet.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalancePet.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小余额设置" Width="760" Height="720" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None" AllowDrop="True" Drop="OnExtensionDrop" DragOver="OnExtensionDragOver"
        Background="Transparent"
        FontFamily="{DynamicResource UiFontFamily}" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="OnWindowLoaded" SourceInitialized="OnWindowSourceInitialized">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/FluentControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#42EBF1F0"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#A8DFE8E6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#8FFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C292B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#637174"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#383B4B4E"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#EFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#13766F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F13766F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#8CEFE0BF"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#785123"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#6613766F"/>
    <CornerRadius x:Key="ThemeCornerRadius">8</CornerRadius>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ThemeControlHeight">32</system:Double>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavigationToggleButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ExtensionActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CatalogActionButton" TargetType="Button" BasedOn="{StaticResource ExtensionActionButton}">
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Horizontal section tabs. The sidebar's TabItem style is vertical-only (fixed
         width, left-hand selection bar), so these carry their own template instead of
         inheriting it. ChipTab is the same idea one size down, for filtering. -->
    <Style x:Key="SectionTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,6,14,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <!-- The gap lives here rather than in the item's Margin, for the same reason the
                 navigation item's does: a TabPanel hands each item a slot the size of the
                 item, and a margin is taken out of that slot instead of sitting outside it,
                 so the right-hand corners of the selected tab were sliced off. -->
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipTab" TargetType="TabItem" BasedOn="{StaticResource SectionTab}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,4,10,4"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <!-- Stretch, not a fixed width. It used to be Width="165" with a 6 px margin on each
           side, which needs 177 px, while the sidebar is 178 px wide and its TabControl
           spends 2 px of that on padding, so every navigation item was 3 px wider than the
           space it had and the right-hand corners of the selected item were clipped away.
           A number that has to agree with two others will eventually stop agreeing;
           filling the space cannot drift. It also fixes the collapsed sidebar, where the
           same 165 px item sat inside a 58 px column. -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="14,9,14,9"/>
      <!-- Horizontal gap only. The vertical gap used to be here as well, and a TabPanel
           hands each item a slot the height of its Height property, so the margin came out
           of that slot rather than sitting outside it: the item drew four pixels shorter
           than it declared and the bottom corners of the selection were sliced off. The gap
           lives on the border inside the template now, where it costs the slot nothing. -->
      <Setter Property="Margin" Value="6,0,6,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="CollapsedTabBackground" Width="43" Height="40"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      CornerRadius="{DynamicResource ThemeCornerRadius}"
                      Background="{DynamicResource SurfaceStrongBrush}" Visibility="Collapsed"/>
              <Border x:Name="TabBorder" Background="Transparent" CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="{TemplateBinding Padding}" Margin="0,1">
                <Grid>
                  <Border x:Name="SelectionIndicator" Width="3" Height="16" Margin="-9,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"
                          Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/>
                <Setter TargetName="CollapsedTabBackground" Property="Opacity" Value="0.5"/>
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="collapsed">
                <Setter TargetName="TabBorder" Property="Background" Value="Transparent"/>
                <Setter TargetName="TabBorder" Property="CornerRadius" Value="0"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="collapsed"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CollapsedTabBackground" Property="Visibility" Value="Visible"/>
                <Setter TargetName="CollapsedTabBackground" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="collapsed"/>
                  <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CollapsedTabBackground" Property="Visibility" Value="Visible"/>
                <Setter TargetName="CollapsedTabBackground" Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentBrush}">
            <Image Source="pack://siteoforigin:,,,/assets/balance-pet.ico" Width="17" Height="17" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="BalancePet" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0"/>
          <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="9,0"/>
          <TextBlock Text="设置" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化">
            <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreWindow" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原">
            <Path Data="M 1.5,1.5 L 10.5,1.5 10.5,10.5 1.5,10.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent"/>
          </Button>
          <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭">
            <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <DockPanel x:Name="SettingsLayoutGrid" Margin="0,0,20,12" LastChildFill="True">
        <Border x:Name="NavigationSidebar" DockPanel.Dock="Left" Width="178" ClipToBounds="True"
                Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="NavigationToggleButton" Grid.Row="0" Panel.ZIndex="5"
            Style="{StaticResource NavigationToggleButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,0,0,0" Padding="14,0,0,0" HorizontalContentAlignment="Left"
            Click="OnToggleNavigation" ToolTip="折叠导航栏" AutomationProperties.Name="折叠导航栏">
      <Path Data="M 0,2 L 12,2 M 0,6 L 12,6 M 0,10 L 12,10" Width="18" Height="18" Stretch="Uniform"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Button>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" Tag="expanded" TabStripPlacement="Left" Padding="2" Margin="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                SelectionChanged="OnTabSelectionChanged">
      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M 4,4 H20 V20 H4 Z M7,8 H17 M7,12 H17 M7,16 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.35" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="AccountNavigationText" Text="账户与接口" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="监控账户" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,5,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfileBox" SelectionChanged="OnProfileSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,0,6,0"/>
              <Button Grid.Column="1" Content="新增" Click="OnAddProfile" Padding="10,4" Margin="0,0,6,0"/>
              <Button Grid.Column="2" Content="删除" Click="OnDeleteProfile" Padding="10,4" Margin="0,0,6,0"/>
              <local:ToggleSwitch x:Name="MonitorEnabledBox" Grid.Column="3" Content="启用" VerticalAlignment="Center" Checked="OnMonitorEnabledChanged" Unchecked="OnMonitorEnabledChanged"/>
            </Grid>
            <TextBox x:Name="ProfileNameBox" TextChanged="OnProfileNameChanged" ToolTip="给这个余额账户起一个容易识别的名称" Margin="0,0,0,14"/>

            <Border x:Name="AccountSummaryCard" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="当前账户" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="AccountSummaryNameText" Text="默认账户" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                  <TextBlock x:Name="AccountSummaryHintText" Text="余额接口尚未配置" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Top">
                  <TextBlock x:Name="AccountSummaryStatusText" Text="已启用" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
              </Grid>
            </Border>

            <TextBlock Text="接口预设"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="auto">自动识别（推荐）</ComboBoxItem>
              <ComboBoxItem Tag="v1-usage">通用 /v1/usage</ComboBoxItem>
              <ComboBoxItem Tag="new-api-token">New API /api/usage/token</ComboBoxItem>
              <ComboBoxItem Tag="deepseek-platform">DeepSeek 官方平台</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义接口</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="PresetHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="SiteUrlLabel" Text="中转站地址"/>
            <TextBox x:Name="SiteUrlBox" TextChanged="OnSiteUrlChanged" Margin="0,5,0,2"/>
            <TextBlock x:Name="SiteUrlHint" Text="只填写站点根地址，例如 https://example.com；程序会自动补全余额接口。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="余额 API 地址"/>
            <TextBox x:Name="EndpointBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,2"/>
            <TextBlock x:Name="EndpointHint" Text="填写中转站文档中的余额查询 URL，不是网站首页或聊天接口。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="逐条费用 API 地址（可选）"/>
            <TextBox x:Name="UsageDetailEndpointBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,2"/>
            <TextBlock Text="填写网页使用记录实际调用的只读明细接口路径或完整 URL，例如 /api/log/self?p=1&amp;page_size=500&amp;type=2；留空时自动探测。只允许访问当前中转站域名。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="认证方式"/>
            <ComboBox x:Name="AuthModeBox" SelectionChanged="OnAuthModeChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,2">
              <ComboBoxItem Tag="bearer">Bearer Token（只填令牌）</ComboBoxItem>
              <ComboBoxItem Tag="authorization">完整 Authorization（需含 Bearer）</ComboBoxItem>
              <ComboBoxItem Tag="websee-session">中转站会话（websee-session）</ComboBoxItem>
              <ComboBoxItem Tag="x-api-key">x-api-key</ComboBoxItem>
              <ComboBoxItem Tag="custom">自定义 Header</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="AuthHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>

            <TextBlock Text="自定义 Header 名"/>
            <TextBox x:Name="HeaderBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/>
            <TextBlock Text="访问令牌（留空保持现有令牌；无令牌时跳过测试）" TextWrapping="Wrap"/>
            <PasswordBox x:Name="TokenBox" PasswordChanged="OnSettingPasswordChanged" Margin="0,5,0,12"/>
            <TextBlock Text="网页会话（可选，用于逐条费用明细）" TextWrapping="Wrap"/>
            <PasswordBox x:Name="WebSessionBox" PasswordChanged="OnSettingPasswordChanged" Margin="0,5,0,2"/>
            <TextBlock Text="优先尝试令牌明细接口；若站点没有该接口，再使用这里的 Cookie 或 websee-session 会话值。仅保存加密后的会话，不会上传。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="高级：从本机浏览器读取会话" FontWeight="SemiBold"/>
                <TextBlock Text="推荐使用浏览器扩展连接；下方本地数据库读取仅作为旧版浏览器的备用方式。浏览器需要已经登录。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="BrowserSessionBrowserBox" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="OnBrowserSessionBrowserChanged">
                    <ComboBoxItem Tag="edge">Microsoft Edge</ComboBoxItem>
                    <ComboBoxItem Tag="chrome">Google Chrome</ComboBoxItem>
                  </ComboBox>
                  <Button x:Name="ReadBrowserSessionButton" Grid.Column="1" Content="本地数据库读取（备用）" Click="OnReadBrowserSessionClick" Padding="12,5"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="通过浏览器扩展连接" Click="OnStartBrowserBridgeClick" Padding="12,5"/>
                  <TextBlock Grid.Column="1" Text="配对码" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="BrowserPairingCodeText" Grid.Column="2" Text="未连接" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="TestUsageSessionButton" Content="测试额度与明细" Click="OnTestUsageSessionClick" Padding="12,5"/>
                  <TextBlock Text="保存后可验证余额接口和逐条费用明细" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="BrowserSessionStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="余额 JSON 路径"/><TextBox x:Name="PathBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="货币 / 货币路径" ToolTip="可直接填货币代码，如 CNY；也可填响应里的字段路径，如 balance_infos.0.currency。填路径时会按原样保留大小写。"/><TextBox x:Name="CurrencyBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12" ToolTip="可直接填货币代码，如 CNY；也可填响应里的字段路径，如 balance_infos.0.currency。填路径时会按原样保留大小写。"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="自动刷新间隔"/>
                <ComboBox x:Name="RefreshBox" SelectionChanged="OnRefreshModeChanged" DropDownClosed="OnComboDropDownClosed" ToolTip="仅控制自动刷新；手动刷新固定至少间隔 5 秒" Margin="0,5,0,2">
                  <ComboBoxItem Tag="off">关闭自动刷新</ComboBoxItem><ComboBoxItem Tag="30">每 30 秒</ComboBoxItem><ComboBoxItem Tag="60">每 1 分钟</ComboBoxItem><ComboBoxItem Tag="300">每 5 分钟</ComboBoxItem><ComboBoxItem Tag="900">每 15 分钟</ComboBoxItem><ComboBoxItem Tag="1800">每 30 分钟</ComboBoxItem><ComboBoxItem Tag="3600">每 1 小时</ComboBoxItem><ComboBoxItem Tag="custom">自定义</ComboBoxItem>
                </ComboBox>
                <TextBox x:Name="RefreshCustomBox" TextChanged="OnSettingTextChanged" Visibility="Collapsed" ToolTip="请输入自动刷新秒数，最少 30 秒" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="低余额阈值"/><TextBox x:Name="ThresholdBox" TextChanged="OnSettingTextChanged" Margin="0,5,0,12"/></StackPanel>
            </Grid>
            <local:ToggleSwitch x:Name="SubscriptionBox" Content="此账户按订阅计费" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,10" ToolTip="勾选后，用量统计中该账户没有费用的任务会显示为「订阅制 · 不计费」。订阅密钥与按量付费密钥在配置上无法区分，因此需要手动声明。"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M 3,5 H21 V16 H3 Z M8,20 H16 M12,16 V20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.35" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="PetNavigationText" Text="桌宠与交互" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="外观与操作" FontWeight="SemiBold" FontSize="15"/>
            <Grid Margin="0,8,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="宠物形象"/>
                <Grid Margin="0,5,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- Filled from PetStyleCatalog.GetAvailableStyles in the constructor: the
                 appearances are packages now, so a list written here would offer every
                 appearance ever published, almost all of them disabled, on an
                 installation that has none of them. -->
            <ComboBox x:Name="PetStyleBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed"/>
                  <Button Grid.Column="1" x:Name="PetStyleUninstallButton" Content="卸载形象" Click="OnUninstallSelectedAppearance" ToolTip="卸载当前形象；随主程序提供的形象与最后一套可用形象不能卸载" Padding="10,5" Margin="6,0,0,0"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="交互模式"/><ComboBox x:Name="InteractionBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,12"><ComboBoxItem Tag="free">自由拖动</ComboBoxItem><ComboBoxItem Tag="locked">锁定互动</ComboBoxItem></ComboBox></StackPanel>
            </Grid>

            <!-- Refusals and failures for the appearance row land here rather than in
                 the extension page's message line, which is on a different tab and
                 would leave the user reading nothing after pressing the button. -->
            <TextBlock x:Name="PetStyleMessageText" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Read from disk rather than from a table, so this shows what the pet
                 window would actually draw: an appearance installed as a package
                 appears here too, and a state that failed to arrive is visible here
                 instead of only in the pet. -->
            <TextBlock x:Name="PetPreviewTitleText" Text="状态预览" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,2"/>
            <TextBlock x:Name="PetPreviewHintText" Text="当前形象在九种状态下的样子。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="8" Margin="0,0,0,12">
              <UniformGrid x:Name="PetPreviewGrid" Rows="3" Columns="3"/>
            </Border>

            <Grid Margin="0,2,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <!-- LargeChange defaults to 1.0, which on a 0.6-1.4 range makes a track
                   click slam the value to whichever end it was nearer. Clicking the
                   track now moves to that point, and the step keys move by 0.05/0.1. -->
              <StackPanel Margin="0,0,8,0"><TextBlock Text="桌宠大小"/><Slider x:Name="ScaleSlider" ValueChanged="OnSettingValueChanged" Minimum="0.6" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.1" Margin="0,8,0,12"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="音量"/>
                <Grid Margin="0,8,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Slider x:Name="VolumeSlider" ValueChanged="OnSettingValueChanged" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.1"/>
                  <Button Grid.Column="1" x:Name="VolumePreviewButton" Click="OnVolumePreviewClick" Margin="10,0,0,0"
                          Width="34" Height="34" Padding="0" ToolTip="点击试听当前音量">
                    <Grid Width="18" Height="18">
                      <Path Data="M 2,5.5 H 4.8 L 8.4,2.6 V 13.4 L 4.8,10.5 H 2 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None"/>
                      <Path Data="M 10.6,5.4 A 3.6,3.6 0 0 1 10.6,10.6 M 12.8,3.2 A 6.4,6.4 0 0 1 12.8,12.8"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                    </Grid>
                  </Button>
                </Grid>
              </StackPanel>
            </Grid>

            <TextBlock Text="交互开关" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,8"/>
            <StackPanel>
              <local:ToggleSwitch x:Name="SoundBox" Content="按压音效" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <local:ToggleSwitch x:Name="BubbleBox" Content="对话气泡" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <local:ToggleSwitch x:Name="InteractionEffectsBox" Content="互动动作" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <local:ToggleSwitch x:Name="NavigationAnimationsBox" Content="设置面板动效" ToolTip="关闭后，设置面板展开和折叠会立即切换，不播放过渡动画。" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,9"/>
              <local:ToggleSwitch x:Name="EasterEggsBox" Content="随机彩蛋" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,12"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M9,3 V7 M15,3 V7 M6,7 H18 V11 A6,6 0 0 1 6,11 Z M12,17 V21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.35" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="AiNavigationText" Text="AI 联动" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="自动跟随 AI 任务" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="勾选后，桌宠会在对应客户端开始任务时显示工作中，结束后显示完成并刷新余额。只传递开始、结束、客户端名和任务 ID，不读取提示词、回复或令牌。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>

            <StackPanel Margin="14,0,0,4">
              <local:ToggleSwitch x:Name="FollowDeepSeekHarnessBox" Content="DeepSeek Harness" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,2"/>
              <TextBlock x:Name="FollowDeepSeekHarnessHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
              <local:ToggleSwitch x:Name="FollowCodexBox" Content="Codex" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,2"/>
              <TextBlock x:Name="FollowCodexHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
              <local:ToggleSwitch x:Name="FollowGeminiBox" Content="Gemini CLI" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,2"/>
              <TextBlock x:Name="FollowGeminiHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
              <local:ToggleSwitch x:Name="FollowQwenBox" Content="Qwen Code" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,2"/>
              <TextBlock x:Name="FollowQwenHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
              <local:ToggleSwitch x:Name="FollowClaudeBox" Content="Claude Code" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,2"/>
              <TextBlock x:Name="FollowClaudeHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
              <local:ToggleSwitch x:Name="FollowOtherBox" Content="其他客户端" ToolTip="任何未在上面列出的客户端，例如自行调用 tools\balancepet-task.ps1 的 CLI" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,12"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M 8,4 H12 V7 H15 C16.1,7 17,7.9 17,9 C17,10.1 16.1,11 15,11 H14 V14 H17 C18.1,14 19,14.9 19,16 C19,17.1 18.1,18 17,18 H13 V21 H9 V18 H6 C4.9,18 4,17.1 4,16 C4,14.9 4.9,14 6,14 H7 V11 H4 C2.9,11 2,10.1 2,9 C2,7.9 2.9,7 4,7 H8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.25" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="ExtensionNavigationText" Text="扩展" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer Padding="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <!-- Rows, not a stack. A StackPanel hands its children infinite height, so the
               lists below could never be told to fill what is left and had to be given a
               fixed Height instead. That is why this page had a large empty region under a
               218 px list, and why that list scrollbar thumb shrank to 23 px. MinHeight is
               bound to the viewport so the star rows have a real height to divide, while a
               window too short to fit everything still scrolls. The 2 px inset lives on the
               ScrollViewer rather than as a margin here: a margin would be added on top of a
               MinHeight that already equals the viewport, and the page would scroll by four
               pixels for no reason. -->
          <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="ExtensionManagementTitleText" Text="扩展管理" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="ExtensionManagementHintText" Text="在线插件库负责发现扩展；功能扩展安装即启用，后台能力会自动运行。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <!-- Two sections that used to share one long page. Downloading something
                 is a different activity from managing what is already on the disk,
                 and mixing them buried the local list under a catalog that can be
                 arbitrarily long. -->
            <TabControl Grid.Row="1" x:Name="ExtensionTabs" Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="0">
              <TabItem Style="{StaticResource SectionTab}">
                <TabItem.Header><TextBlock x:Name="OnlineLibraryTabText" Text="在线插件库"/></TabItem.Header>
                <Grid Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="PluginCatalogHintText" Text="从 BalancePet 官方目录发现插件；下载后仍会执行本地安全校验。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="PluginCatalogRefreshButton" Grid.Column="1" Content="刷新目录" Click="OnRefreshPluginCatalog" ToolTip="刷新在线插件目录" Padding="10,5"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="PluginCatalogSearchBox" Height="29" ToolTip="搜索插件名称、作者或分类" TextChanged="OnPluginCatalogSearchChanged"/>
                  <TextBlock Grid.Column="1" x:Name="PluginCatalogCountText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <!-- Filtering by kind, because the catalog mixes plugins, appearances,
                     themes and browser extensions, and the useful question is usually
                     about only one of them. -->
                <TabControl Grid.Row="2" x:Name="PluginCatalogCategoryTabs" Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4" SelectionChanged="OnPluginCatalogCategoryChanged">
                  <TabItem Style="{StaticResource ChipTab}" Tag=""><TabItem.Header><TextBlock x:Name="CatalogCategoryAllText" Text="全部"/></TabItem.Header></TabItem>
                  <TabItem Style="{StaticResource ChipTab}" Tag="feature"><TabItem.Header><TextBlock x:Name="CatalogCategoryFeatureText" Text="功能"/></TabItem.Header></TabItem>
                  <TabItem Style="{StaticResource ChipTab}" Tag="pet"><TabItem.Header><TextBlock x:Name="CatalogCategoryPetText" Text="形象"/></TabItem.Header></TabItem>
                  <TabItem Style="{StaticResource ChipTab}" Tag="theme"><TabItem.Header><TextBlock x:Name="CatalogCategoryThemeText" Text="主题"/></TabItem.Header></TabItem>
                  <TabItem Style="{StaticResource ChipTab}" Tag="browser"><TabItem.Header><TextBlock x:Name="CatalogCategoryBrowserText" Text="浏览器"/></TabItem.Header></TabItem>
                </TabControl>
                <Grid Grid.Row="3">
                <ListBox x:Name="PluginCatalogListBox" PreviewMouseWheel="OnListPreviewMouseWheel" MinHeight="120" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" Margin="0,2" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="32" Height="32" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" VerticalAlignment="Top">
                            <Image Source="pack://siteoforigin:,,,/assets/balance-pet.ico" Width="22" Height="22" Stretch="Uniform"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="{Binding ActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallPluginCatalogItem" IsEnabled="{Binding CanInstall}" Visibility="{Binding ActionVisibility}" Style="{StaticResource CatalogActionButton}"/>
                            <Button Content="{Binding RepositoryText}" Click="OnOpenPluginCatalogRepository" ToolTip="{Binding RepositoryText}" Padding="4,3" Margin="0,5,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                  <!-- Says why the list is empty, because an empty box of fixed height
                       reads as a loading failure rather than as "nothing matches". -->
                  <TextBlock x:Name="PluginCatalogEmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                             MaxWidth="330" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <TextBlock Grid.Row="4" x:Name="PluginCatalogStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </Grid>
              </TabItem>
              <TabItem Style="{StaticResource SectionTab}">
                <TabItem.Header><TextBlock x:Name="LocalExtensionsTabText" Text="本地扩展功能"/></TabItem.Header>
                <StackPanel Margin="0,12,0,0">
            <TextBlock x:Name="LocalExtensionsHintText" Text="已下载到扩展库的 ZIP 会显示在这里；扫描到不代表已经安装。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <ListBox x:Name="ExtensionListBox" PreviewMouseWheel="OnListPreviewMouseWheel" AllowDrop="True" Drop="OnExtensionDrop" DragOver="OnExtensionDragOver" MinHeight="120" SelectionChanged="OnExtensionSelectionChanged" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" Padding="7" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="9,8" Margin="0,2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding InstallActionText}" ToolTip="{Binding InstallTooltip}" Click="OnInstallOrUninstallExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding CanInstallOrUninstall}"/>
                        <Button Content="{Binding ToggleActionText}" ToolTip="{Binding ToggleTooltip}" Click="OnToggleExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding IsInstalled}" Visibility="{Binding ToggleVisibility}"/>
                        <Button Content="{Binding UpdateActionText}" ToolTip="{Binding UpdateTooltip}" Click="OnUpdateExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding HasUpdate}"/>
                        <Button Content="{Binding LaunchActionText}" ToolTip="{Binding LaunchTooltip}" Click="OnLaunchExtension" Style="{StaticResource ExtensionActionButton}" IsEnabled="{Binding CanLaunch}" Visibility="{Binding LaunchVisibility}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="扩展库操作" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,5"/>
            <WrapPanel Margin="0,0,0,7">
              <Button x:Name="ExtensionScanButton" Content="扫描库" ToolTip="扫描扩展库" Click="OnScanExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionOpenButton" Content="打开文件夹" ToolTip="打开扩展库" Click="OnOpenExtensionLibrary" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionImportButton" Content="导入 ZIP" ToolTip="导入 ZIP 到扩展库" Click="OnInstallExtension" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionCleanupButton" Content="清理旧版" ToolTip="删除旧版扩展资源，保留当前版本" Click="OnCleanupExtensionResources" Padding="10,5" Margin="0,0,6,0"/>
              <Button x:Name="ExtensionCheckButton" Content="检查更新" ToolTip="检查扩展更新" Click="OnCheckExtensionUpdates" Padding="10,5"/>
            </WrapPanel>
            <TextBlock x:Name="ExtensionUpdateStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock x:Name="ExtensionMessageText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="10" CornerRadius="4">
              <TextBlock Text="扩展不会写入主程序安装目录。禁用或卸载当前正在使用的资源扩展后，桌宠会回退到内置形象；功能扩展始终在独立进程中运行。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4 M12,8 A4,4 0 1 1 11.99,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.35" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="AppearanceNavigationText" Text="外观" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="4,0,2,16">
            <TextBlock Text="主题插件" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="外观" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="让设置窗口融入 Windows，同时保持信息清晰、操作安静。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18"/>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerRadius}" Padding="14" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                  <Path Data="M 9,4 L 17,4 21,8 21,16 17,20 9,20 5,16 5,8 Z M 9,8 L 17,8 M 9,12 L 17,12 M 9,16 L 14,16" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Margin="10"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                  <TextBlock x:Name="CurrentThemeNameText" Text="BalancePet 云母" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CurrentThemeDescriptionText" Text="系统云母底层、Fluent 控件与 BalancePet 青绿色强调色。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock x:Name="CurrentThemeMetaText" Text="主题扩展 · v1.0.0 · GoldenMoon" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,3" VerticalAlignment="Top">
                  <TextBlock Text="已启用" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </Border>

            <TextBlock Text="当前主题" FontWeight="SemiBold"/>
            <ComboBox x:Name="ThemeBox" SelectionChanged="OnThemeSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,16"/>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="颜色模式" FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeModeBox" SelectionChanged="OnThemeOptionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,0">
                  <ComboBoxItem Tag="system">跟随系统</ComboBoxItem>
                  <ComboBoxItem Tag="light">浅色</ComboBoxItem>
                  <ComboBoxItem Tag="dark">深色</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="窗口材质" FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeBackdropBox" SelectionChanged="OnThemeOptionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,6,0,0">
                  <ComboBoxItem Tag="mica" ToolTip="跟随桌面壁纸取色，窗口会随壁纸变化。">云母</ComboBoxItem>
                  <ComboBoxItem Tag="solid" ToolTip="不使用任何系统材质，窗口完全不透明。">实色</ComboBoxItem>
                </ComboBox>
              </StackPanel>
            </Grid>

            <!-- Full width, because font names are long and the Chinese and English ones have
                 to be told apart at a glance. Each entry is drawn in its own face: a list of
                 font names all set in one font says nothing about any of them. -->
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="界面字体" FontWeight="SemiBold"/>
              <!-- Pinned to the label face, which never changes, rather than to UiFontFamily, which
                     this very control changes. Every control in the window re-templates when
                     UiFontFamily changes, and a re-template builds a fresh selection TextBlock
                     with none of the text that was written into the old one. That is why this
                     is the only combo that goes blank: it is the only one that changes the
                     resource its own template depends on. Choosing 跟随系统 resolves to the face
                     already in use, the change is skipped, and the box keeps its text. -->
                <ComboBox x:Name="UiFontBox" FontFamily="{DynamicResource UiLabelFontFamily}" SelectionChanged="OnUiFontChanged"
                        Margin="0,6,0,0" MaxDropDownHeight="320"
                        ToolTip="设置窗口、提示气泡和更新记录使用的字体。">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <!-- Fixed height, and this is not cosmetic. Each row is drawn in the face
                         it names, faces load when first shown, and faces disagree about line
                         height: an unconstrained row measures anywhere from 25 to 46 px. A row
                         that grows after the panel has measured it moves every row below it,
                         so the list scrolls itself while the pointer moves across it. -->
                    <TextBlock Text="{Binding Label}" FontFamily="{Binding Preview}"
                               Height="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
              <TextBlock Text="云母会让窗口跟随桌面壁纸取色；Windows 10 上没有云母，改用系统自带的亚克力。高对比度或关闭系统透明效果时一律回退为实色。" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button Content="打开主题目录" Click="OnOpenThemeDirectory" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="导入主题 ZIP" Click="OnImportThemePackage" Padding="12,6"/>
            </StackPanel>
            <TextBlock x:Name="ThemeMessageText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M4,6 H20 M4,12 H20 M4,18 H20 M8,4 V8 M16,10 V14 M11,16 V20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.35" Width="18" Height="18" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="AdvancedNavigationText" Text="高级与迁移" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Margin="2">
            <TextBlock Text="应用偏好" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="自动检查更新" Margin="0,12,0,0"/>
            <ComboBox x:Name="UpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="自动检查扩展更新"/>
            <ComboBox x:Name="ExtensionUpdateCheckBox" SelectionChanged="OnComboSelectionChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,14"><ComboBoxItem Tag="startup">每次启动时</ComboBoxItem><ComboBoxItem Tag="daily">每天一次（推荐）</ComboBoxItem><ComboBoxItem Tag="weekly">每周一次</ComboBoxItem><ComboBoxItem Tag="manual">仅手动检查</ComboBoxItem></ComboBox>
            <TextBlock Text="语言"/>
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" DropDownClosed="OnComboDropDownClosed" Margin="0,5,0,18"><ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem></ComboBox>
            <local:ToggleSwitch x:Name="StartupBox" Content="随 Windows 启动（进入托盘）" Checked="OnSettingToggleChanged" Unchecked="OnSettingToggleChanged" Margin="0,0,0,18"/>

            <Separator Margin="0,0,0,14"/>
            <TextBlock Text="设置迁移" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="导出文件不包含访问令牌。迁移到其他用户或电脑后，需要重新填写令牌。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
            <WrapPanel>
              <Button Content="导入设置" Click="OnImport" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="导出设置" Click="OnExport" Padding="12,6"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
          </Grid>
        </Border>

        <Grid x:Name="SettingsContentGrid">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}" Padding="16,2,2,2">
      <ContentPresenter x:Name="SettingsContentHost" Content="{Binding SelectedContent, ElementName=SettingsTabs}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="1">
        <!-- Named so the page transition can move the content without disturbing layout:
             a RenderTransform does not re-measure, so a sliding page cannot make the
             scrollbar jump while it moves. -->
        <ContentPresenter.RenderTransform>
          <TranslateTransform x:Name="SettingsContentShift" X="0"/>
        </ContentPresenter.RenderTransform>
      </ContentPresenter>
    </Border>
    <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="28" Margin="0,0,0,6"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="OnCancel" Padding="18,7" Margin="0,0,8,0"/>
      <Button Content="确定" Click="OnOk" Padding="18,7" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
      <Button Content="应用" Click="OnApply" Padding="18,7"/>
    </StackPanel>

        </Grid>
      </DockPanel>
      <Grid x:Name="UnsavedOverlay" Grid.Row="1" Margin="0,0,20,12" Visibility="Collapsed" Panel.ZIndex="20" Background="#660E1729">
        <Border Width="380" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
          <StackPanel>
            <TextBlock x:Name="UnsavedDialogTitleText" Text="未保存的设置" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="UnsavedDialogMessageText" Text="设置尚未保存，确定放弃更改并关闭吗？" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="UnsavedKeepEditingButton" Content="继续编辑" Click="OnKeepEditingClick" Padding="12,6" Margin="0,0,8,0"/>
              <Button x:Name="UnsavedDiscardButton" Content="放弃更改" Click="OnDiscardChangesClick" Padding="12,6" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
