{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GoldenMoon-cell/BalancePet/blob/main/docs/extension-spec/feature-v1/manifest.schema.json",
  "title": "BalancePet feature extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "version", "api_version", "min_core_version", "entrypoint", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^balancepet\\.ext\\.[a-z0-9](?:[a-z0-9.-]{0,79}[a-z0-9])?$" },
    "type": { "const": "feature" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "name_en": { "type": "string", "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "api_version": { "const": 1 },
    "min_core_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "update_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://api\\.github\\.com/repos/[^/]+/[^/]+/releases/latest$",
      "maxLength": 500
    },
    "entrypoint": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+$", "maxLength": 120 },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["usage.read", "notifications.read", "notifications.present"] } }
  }
}
